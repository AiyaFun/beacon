# 烽火台 · 开发环境变量模板
#
#   cp .env.example .env && npm run setup && npm run dev
#
# 这份文件是**开发**模板，生产部署请用 .env.production.example（那份要求填齐真实密钥）。
#
# ── 铁律：dev 态零基础设施可跑 ──────────────────────────────────
# 不需要 Redis、不需要 Postgres、不需要任何 API Key、不需要 BEACON_MASTER_KEY。
# 下面**只有 DATABASE_URL 是必需的**，其余全部注释掉即可跑通全流程：
#   · LLM       无 key → Mock provider（确定性假数据，可离线跑）
#   · 短信       无 vendor → Mock 通道，验证码直接回显在登录页，随便填手机号就能登
#   · 数据源     无 key → 内置 Mock 热榜 / 竞对数据
#   · 队列       无 REDIS_URL → 进程内队列
#   · 限流       无 REDIS_URL → 进程内计数
#   · 主密钥     dev 态用内置弱默认值（生产不配会 fail-fast）
# 想接真实能力时，再把对应那行取消注释填上——**填哪个切哪个**，不用全填。

# ── 数据库（唯一必填）──────────────────────────────────────────
# 开发态 SQLite，文件落在 prisma/dev.db（已被 .gitignore 忽略）。
# 不设这条 → npm run setup 会直接死在 prisma P1012（Environment variable not found）。
DATABASE_URL="file:./dev.db"

# ── 运行模式 ────────────────────────────────────────────────────
# 不设即为 dev。⚠️ 本地千万别设成 prod / 别设 NODE_ENV=production：
# 那会触发一串生产 fail-fast（短信通道、主密钥），本地直接跑不起来。
# BEACON_ENV="dev"

# ── LLM 网关（不填走 Mock）──────────────────────────────────────
# 任意 OpenAI 兼容端点（DeepSeek / Qwen / Kimi / GLM / OpenAI …）。
# 也可以不动这里，起服务后在 /settings 页面加租户级 BYOK key。
# BEACON_DEFAULT_LLM_BASE_URL="https://api.deepseek.com"
# BEACON_DEFAULT_LLM_API_KEY=""
# BEACON_DEFAULT_LLM_MODEL="deepseek-chat"

# ── 向量嵌入（不填则语义检索/聚类降级为关键词匹配，不报错）────────
# BEACON_EMBED_BASE_URL=""
# BEACON_EMBED_API_KEY=""
# BEACON_EMBED_MODEL="bge-m3"

# ── 数据源（不填全走内置 Mock）──────────────────────────────────
# 自部署的开源热榜实例（DailyHotApi），配了就最优先走它
# BEACON_DAILYHOT_BASE_URL=""
# 60s 通道总开关。⚠️ dev 默认**离线**：不设它 → 热榜全走内置 Mock、零网络（守铁律）。
# 想在本地试真实热榜（免 key 连公开实例 https://60s.viki.moe），取消下一行注释：
# BEACON_HOT60S="1"
# ⚠️ 公开实例是个人维护的免费服务、无 SLA：某个源抓不到时只有该源回退 Mock，其余源不受影响。
#   （生产态相反：默认就接真，见 .env.production.example。）
# 想指向自部署的 60s 实例：设 BEACON_60S_BASE_URL；想彻底禁用这个源：BEACON_60S_DISABLED="1"。
# BEACON_60S_BASE_URL=""
# BEACON_60S_DISABLED=""
# 自部署 RSSHub 实例（竞对监控·开源自建通道）：配了就作为竞对"发新内容"监控的备源/主源。
# RSS 里没有播放/点赞指标——指标靠商业 API 或浏览器插件回传补。抖音/小红书路由需在
# RSSHub 实例侧配置 cookie 才可用（见 RSSHub 文档），拿不到时自动降级，不硬闯。
# BEACON_RSSHUB_BASE_URL=""
# 竞对采集：填哪个平台的 key，哪个平台切真实，其余继续 Mock
# BEACON_TIKHUB_KEY=""
# BEACON_NEWRANK_KEY=""
# BEACON_YOUTUBE_API_KEY=""
# BEACON_TWITTERAPI_KEY=""
# BEACON_BILIBILI_ENABLED=""

# ── Agent Skills 导出（不填则该功能不可用，其余正常）────────────
# BEACON_ANTHROPIC_API_KEY=""

# ── 短信（不填 = Mock 通道，验证码回显登录页）────────────────────
# ⚠️ dev 才允许留空。生产留空 = 验证码明文回显 = 账号接管，见 .env.production.example。
# BEACON_SMS_VENDOR=""

# ── BYOK 信封加密主密钥 ────────────────────────────────────────
# dev 不配则用内置默认值。生产必须配，否则 fail-fast。生成：openssl rand -base64 48
# BEACON_MASTER_KEY=""

# ── 队列（不填 = 进程内，够开发用）──────────────────────────────
# BEACON_QUEUE="bullmq"
# REDIS_URL="redis://127.0.0.1:6379"

# ── 配额（dev 默认关；见 lib/quota.ts）──────────────────────────
# 显式 "1" 才在 dev 下开启，方便本地验配额拦截逻辑。
# BEACON_QUOTA_ENABLED="0"

# ── AIGC 标识主体名（不填回退「烽火台」）────────────────────────
# 两个要填成同一个值：服务端导出读 BEACON_，浏览器「复制正文」出口读 NEXT_PUBLIC_。
# BEACON_AIGC_PRODUCER="烽火台"
# NEXT_PUBLIC_AIGC_PRODUCER="烽火台"

# ── 采集助手浏览器插件·Chrome 应用商店链接（上架审核通过后填，见 extension/store/PUBLISH.md）──
# 只提交 Chrome 一家；Edge/360/Brave 不单独上架，永远走 zip 开发者模式加载。
# 空 = 未上架，Chrome 卡片显示「商店审核中」，全部回落到自托管 zip + 开发者模式加载。
# BEACON_EXT_STORE_CHROME=""

# ══════════════════════════════════════════════════════════════════
# 以下都是 **dev 完全不需要** 的：生产才用得上，或只在特定场景用。
# 列在这里是为了让「到底还有哪些 key」一眼能数清（完整说明见 docs/凭证清单.md）。
# ══════════════════════════════════════════════════════════════════

# ── 微信扫码登录（不填 = 登录页不显示微信入口，手机号验证码照常可用）──
# 微信开放平台 → 网站应用（需企业资质 + 300元/年认证）
# BEACON_WECHAT_APPID=""
# BEACON_WECHAT_SECRET=""

# ── 短信真实通道（dev 留空 = 验证码回显登录页）────────────────────
# 火山引擎短信服务。BEACON_SMS_VENDOR="volc" 时以下才必填。
# BEACON_VOLC_SMS_AK=""            # 火山引擎 AccessKey ID
# BEACON_VOLC_SMS_SK=""            # 火山引擎 Secret AccessKey
# BEACON_VOLC_SMS_ACCOUNT=""       # 短信应用（SMSAccount）
# BEACON_VOLC_SMS_SIGN=""          # 已报备的短信签名
# BEACON_VOLC_SMS_TEMPLATE=""      # 已报备的模板 ID
# BEACON_VOLC_SMS_PARAM_NAME="code"  # 模板里验证码占位符名，默认 code
# BEACON_VOLC_SMS_REGION="cn-north-1"

# ── 微信支付（dev 留空 = Mock 支付通道，可跑通下单/回调全流程）──────
# 只有 BEACON_PAY_VENDOR="wxpay" 时下面 7 项才必填，缺任一项启动即报错（不会等到用户付了钱才发现）。
# BEACON_PAY_VENDOR=""
# BEACON_WXPAY_MCHID=""            # 商户号
# BEACON_WXPAY_SERIAL_NO=""        # 商户 API 证书序列号
# BEACON_WXPAY_PRIVATE_KEY=""      # 商户 API 私钥 PEM（apiclient_key.pem 全文）
# BEACON_WXPAY_APIV3_KEY=""        # APIv3 密钥，**必须 32 个字符**
# BEACON_WXPAY_PUBLIC_KEY=""       # 微信支付公钥 PEM
# BEACON_WXPAY_PUBLIC_KEY_ID=""    # 公钥 ID，**必须 PUB_KEY_ID_ 前缀**（填成平台证书序列号是最常见的错）
# BEACON_WXPAY_NOTIFY_URL=""       # 支付回调（须公网 HTTPS 可达）
# BEACON_WXPAY_REFUND_NOTIFY_URL="" # 退款回调

# ── 运维口令（都不是第三方 key，自己生成即可：openssl rand -hex 32）──
# 退款通道总开关：**不配 = 退款接口一律 503**（默认关，防误触发）
# BEACON_ADMIN_TOKEN=""
# /api/health 详情鉴权：配了才需要带 token 才给组件详情，不配只回状态
# BEACON_HEALTH_TOKEN=""

# ── 出海代理（国内服务器够不到 Google/YouTube 时必需）──────────────
# BEACON_HTTP_PROXY=""             # 如 http://127.0.0.1:7890
# BEACON_YOUTUBE_REGION="US"       # YouTube 热榜地区，默认 US

# ── 客服渠道（billing 页展示；不填显示占位符=给用户假联系方式）──────
# BEACON_CS_WECHAT=""
# BEACON_CS_EMAIL=""

# ── 站点地址 / 可观测性 / 调参（都有默认值，按需覆盖）──────────────
# BEACON_PUBLIC_URL=""             # 对外可访问地址（机器人卡片里的链接用它拼）
# BEACON_SITE_URL=""               # sitemap/robots 用
# 整机版/私有化「一键增量更新」的下载源。**只认这里配的或代码里的官方站，绝不接受调用方传入**
# （它决定客户机器会去哪儿下代码并执行，等同于信任根）。私有化客户指到自建分发站时改这一条。
# BEACON_UPDATE_ORIGIN="https://beacon.iyunci.cn"
# BEACON_TRUSTED_PROXY_HOPS="0"    # 反代层数，生产必须按实际填（0 会 fail-fast）
# BEACON_SENTRY_DSN=""             # 不填则只打本地日志
# BEACON_LOG_LEVEL="info"
# BEACON_SERVICE="web"
# BEACON_RELEASE=""
# BEACON_WORKER_CONCURRENCY="4"
# BEACON_CLUSTER_SIM=""            # 热点聚类相似度阈值，不填用代码内默认

# ── 邮件通道：已于 2026-07-30 整体下线，不再有 BEACON_MAIL_* ────────────────
# 到期/账单提醒走「站内通知 + 顶部横幅（ExpiryBanner）+ 机器人推送」三条腿。
