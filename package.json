{
  "name": "beacon",
  "version": "1.2.0",
  "private": true,
  "description": "烽火台 · 跨平台内容作战室 — 面向创作者/内容团队的多平台选题创作 SaaS",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run pack:ext && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:redis": "vitest run --config tests/redis/vitest.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preflight": "tsx scripts/preflight.ts",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "sync:system-data": "tsx scripts/sync-system-data.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "pack:ext": "tsx scripts/pack-extension.ts",
    "db:reset": "rm -f prisma/dev.db && prisma db push --skip-generate && tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts",
    "connector": "tsx connector.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@prisma/client": "5.22.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "next": "15.1.6",
    "nodemailer": "^9.0.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "undici": "^7.28.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "20.17.6",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^29.1.1",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "^2.1.8"
  }
}
