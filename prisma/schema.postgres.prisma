// 烽火台 · 数据模型 (PRD §14)
// 开发态 provider=sqlite；生产态改为 postgresql 并启用 pgvector。
// 注意：为 SQLite 兼容，枚举用 String 常量、JSON/数组字段用 String 存 JSON（应用层 lib/json.ts 序列化）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── 域1：租户与账号 ───────────────────────────

model Tenant {
  id            String    @id @default(cuid())
  name          String
  plan          String    @default("free") // free | personal | team | enterprise
  // 平台侧封禁开关（超管在 /ops 里改）。active | suspended。
  // 判据只在 lib/auth.ts 一处生效：登录时拒发会话、已签发的会话下一次请求即失效。
  // 刻意**不删数据**——封禁是运营手段不是注销，解封后一切照旧（注销走 AccountDeletion）。
  status        String    @default("active")
  suspendReason String? // 封禁原因，登录页原样回给用户（写给用户看的人话，别写内部黑话）
  // 付费档到期时间。null = 无到期日（free 档，或从未付费）。
  // 手动续费模式（不做委托代扣）下，「订阅」= plan + 这个到期时间，不另立 Subscription 表：
  // Tenant.plan 已是 lib/quota.ts planOf() 的唯一真值来源，拆表必然造成双写漂移。
  // 付费历史/对账由 PaymentOrder 流水承担。
  planExpiresAt DateTime?
  createdAt     DateTime  @default(now())

  workspaces         Workspace[]
  members            Member[]
  invites            Invite[]
  modelProviders     ModelProvider[]
  paymentOrders      PaymentOrder[]
  contentSkills      ContentSkill[]
  workflowTemplates  WorkflowTemplate[]
  workflowInstalls   WorkflowInstall[]
  skillInstalls      SkillInstall[]
  complianceFeedback ComplianceFeedback[]

  // 到期降级 job：扫 plan != 'free' 且 planExpiresAt < now
  @@index([plan, planExpiresAt])
}

model Workspace {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  // 插件采集令牌（竞对监控 authorized 通道）：浏览器插件回传公开页数据时的鉴权凭证。
  // null = 未启用。settings 页生成/轮换/停用；明文存储是权衡后的选择——它只授权
  // 「向本工作区已订阅的竞对补充公开数据」这一件事，权限面远小于登录态，且需要支持回显。
  ingestToken      String?  @unique
  // 自动化任务开关（JSON）：每日推荐/数据同步/自动复盘/记忆优化等定时任务的按工作区开关。
  // 缺省 '{}' → 各项取默认（多数为开），保持既有全自动行为。见 lib/jobs/automation.ts。
  automationConfig String   @default("{}")
  // AI 能调的系统能力开关（JSON）：只记**被关掉的**那些（{"create_draft":false}）。
  // 缺省 '{}' → 全开，加新工具不必要求每个工作区先去打开一次。见 lib/agent/tool-config.ts。
  agentToolConfig  String   @default("{}")
  // 「让插件替我打开并读取指定网页」的开关。**默认关，必须用户显式打开**。
  //
  // 与 agentToolConfig 里那些工具开关不同（那些缺省全开），这一项缺省是关的：
  // 它是唯一一个由服务端指定 URL、让用户已登录的浏览器去打开的能力，
  // 属于「用户得知道自己开了什么」的那一类，不能靠默认值替他决定。
  browserReadEnabled Boolean @default(false)
  createdAt        DateTime @default(now())

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts        CreatorAccount[]
  watchlistItems  WatchlistItem[]
  memories        MemoryEntry[]
  tasks           TaskItem[]
  botIntegrations BotIntegration[]
  inspirations    InspirationItem[]
  readerComments  ReaderComment[]
  mediaAssets     MediaAsset[]
  coverStyles     CoverStylePreset[]
  collectionRuns  CollectionRun[]
  ingestTokens    IngestToken[]
  agentRuns       AgentRun[]
  taskPresets     TaskPreset[]
  publishPlans    PublishPlan[]
  workflowRuns    WorkflowRun[]
  scheduledAgents ScheduledAgent[]
  browserTasks    BrowserTask[]
  parserIncidents ParserIncident[]
}

// 插件采集令牌（按设备签发，可逐枚吊销）。
//
// 为什么不能只留 Workspace.ingestToken 那一枚：它是工作区级的**单枚**凭证——谁装插件都填同一串，
// 于是「吊销」只有全有或全无两档。成员离开工作区、某台电脑丢了、只想收回自己那一台，都做不到。
// 2026-07-30 的注销缺口正是这么暴露的：服务端撤销不了「某个人的那一枚」，
// 只能把整个工作区的采集一起掐掉（连还在用的同事一起）。
//
// 每次「一键配置到插件」或手动生成都签发一行。memberId 是签发人，
// **成员被删除时外键级联带走他名下的全部令牌**——这条不能靠应用层记得去删，
// 忘一次就等于「人已经离开工作区，他那台电脑还在往里写数据」。
//
// 明文存储沿用旧字段的权衡：只授权「向本工作区回传采集数据」这一件事，权限面远小于登录态，
// 且用户需要把它重新复制到另一台设备的插件里。
model IngestToken {
  id          String    @id @default(cuid())
  workspaceId String
  // 令牌明文（bcn_ 前缀）。存量兼容：新签发的令牌只存哈希，此字段留给迁移期旧令牌兜底查询。
  // 迁移完成后（所有行都有 tokenHash）可清空此列。
  token       String    @unique
  // SHA-256 哈希（hex）。新签发的令牌鉴权走这条索引，数据库泄露时无法直接冒用。
  tokenHash   String?   @unique
  // 设备标签，签发时按 User-Agent 生成，如「Chrome · macOS」。用户靠它认出这是哪一台
  label       String
  // 签发人。null = 从旧的工作区级令牌迁移进来的，没有签发人可考
  memberId    String?
  createdAt   DateTime  @default(now())
  // 最后一次鉴权成功的时间。**节流写入**（见 lib/ingest/token.ts TOUCH_INTERVAL_MS）：
  // 每条回传都更新它，等于给每个采集请求平白加一次写库
  lastUsedAt  DateTime?
  // 非空 = 已吊销。不删行——用户要看得到「这台设备是什么时候、因为什么被收回的」
  revokedAt   DateTime?
  revokedNote String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([workspaceId, revokedAt])
  @@index([memberId])
}

// ─────────────────────────── 域: 采集台账 ───────────────────────────
//
// 每一次抓取动作落一行，核心是记下**这一批数据覆盖了哪段时间**。
//
// 为什么必须记：所有通道都只取"最近一小段"——公众号后台单次翻 2 页 / 近 7 天，
// 自有后台跟着后台默认时段走，服务端 RSS 只给最新几条。用户在页面上看到的是
// 「库里有 N 篇」，却无从知道**哪段时间采过、哪段是窟窿**；要补历史时更不知道从哪补起。
// lastCrawledAt 只回答"最后一次是什么时候跑的"，回答不了"跑到的是哪几天的内容"。
//
// 一行 = 一次回传/一次抓取，不是一条作品。竞对档案虽是全局共享表，台账仍按工作区记——
// 「谁在什么时候采到了哪个时段」是本工作区的操作记录，不该跨租户可见。
//
// 不设 targetId 外键：账号删除后台账要留着（"我采过什么"是操作历史，不随对象消失）。
model CollectionRun {
  id          String    @id @default(cuid())
  workspaceId String
  scope       String // self（自有账号）| rival（竞对账号）
  platform    String
  // 自有 = CreatorAccount.id；竞对 = CompetitorAccount.id。无外键，见上方注释
  targetId    String?
  // 采集当时的账号名快照（账号改名/删除后台账仍可读）
  targetName  String
  // plugin_home（插件在公开主页采）| plugin_backend（插件在后台采）| server（服务端定时/RSS）
  // | import（文件导入）| manual（页面上手动点）
  channel     String
  ranAt       DateTime  @default(now())
  // 本批内容的发布时间跨度，两端都含。整批都没有发布时间时为 null（如只回传了指标）
  coveredFrom DateTime?
  coveredTo   DateTime?
  // 本批收到的条数（作品数，或账号级日数据的天数）；其中新入库 created / 更新已有 updated
  items       Int       @default(0)
  created     Int       @default(0)
  updated     Int       @default(0)
  // 降级、节流、没采到的原因；正常批次为 null
  note        String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope, ranAt])
}

// ─────────────────────────── 域: 机器人集成（飞书/其它平台 bot）───────────────────────────
// 一键配置飞书机器人 + 通过 bot 收录内容、驱动内容引擎（需求③④）。
// provider 可插拔：feishu 先落地；钉钉/企微/telegram 加 adapter 即可复用本表与 lib/bot。
model BotIntegration {
  id          String  @id @default(cuid())
  workspaceId String
  provider    String // feishu | dingtalk | wecom | telegram | slack
  label       String  @default("")
  enabled     Boolean @default(true)

  // 出站（群自定义机器人 webhook）：把热点/提醒/合规/学习小结推到群。
  webhookUrl String?

  // 入站路由键（Feishu=app_id）：事件回调用它反查工作区。@unique 防串工作区。
  // null = 只配了出站、没开入站。
  inboundKey String? @unique

  // 加密 JSON（lib/crypto.encryptKey）：{ signSecret?, appSecret?, verificationToken?, encryptKey? }。
  // 出站签名密钥、入站应用密钥/校验串/加密串都在这里，明文不落库。
  secretsEnc String @default("")

  // 推送事件订阅（JSON string[]）：hot_ready | daily_recommend | refresh_reminder | compliance_alert | learning_summary
  pushEvents String @default("[]")

  // 定时推送配置（如 "09:00", "18:00", "09:00,18:00"）
  pushSchedule String @default("09:00")

  // 入站命令白名单（JSON string[]）：控制此 bot 能触发哪些操作；空=默认集（只收录、不自动发布）。
  allowCommands String @default("[]")

  // 观测：最后入/出站时间与错误，设置页显示健康。
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations BotConversation[]

  @@index([workspaceId, provider])
}

// 群内对话上下文（@机器人 多轮对话）。一个 (集成, 会话) 一行。
//
// 为什么不放内存：蓝绿部署每次切换都会换掉 web 容器，内存里的上下文会静默清空——
// 用户看到的是「机器人突然不记得刚才聊了什么」，而这类偶发失忆最难被当成 bug 报上来。
// 这张表是易失数据，超时（BOT_CHAT_TTL_MS）即视为新会话，不做历史归档。
model BotConversation {
  id            String   @id @default(cuid())
  workspaceId   String // 冗余一份：RLS 按它做租户隔离，也便于按工作区清理
  integrationId String
  chatId        String // provider 内的会话 id（飞书 chat_id / 企微 FromUserName / 钉钉 conversationId）
  // 本群「当前账号」：/账号 <名字> 绑定。对话上下文与 /分析 都以它为准。
  // null = 未绑定，按「工作区唯一活跃账号」推断；多账号且未绑定时机器人会要求先绑定，
  // 绝不替用户猜——猜错等于把数据记到别人名下（见 /data 的按 accountId 过滤）。
  accountId     String?
  turns         String   @default("[]") // 最近若干轮 JSON [{role,content}]
  turnsAt       DateTime @default(now()) // 最后一轮时间；与 updatedAt 分开，绑账号不算续上对话
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration BotIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, chatId])
  @@index([workspaceId])
}

model Member {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  phone          String?   @unique // 手机号（短信验证码登录主标识）
  email          String?   @unique
  wechatOpenId   String?   @unique // 微信登录 openid（此前只加在 sqlite schema，生产构建因此类型报错）
  // 本机密码登录（个人创作者小站）：仅 appliance/private 形态启用（MATRIX.passwordLogin）。
  // scrypt 格式 `scrypt:N:r:p:<saltB64>:<hashB64>`，见 lib/auth/password.ts。null = 未设密码。
  passwordHash   String?
  // 企业应用（飞书/钉钉/企微）登录身份，格式 `<provider>:<openId>`，例如 `feishu:ou_xxx`。
  // 【为什么合成一列而不是 provider + openId 两列】一个实例只接一家企业应用（装机向导里选定），
  // 跨家不会共存；合成一列换来一条简单的唯一约束，两库行为一致，也不必再维护复合索引。
  // ⚠️ 不透明 ID 不许转小写（大小写敏感），见 lib/auth/oa.ts。
  oaIdentity     String?   @unique
  role           String    @default("owner") // owner | admin | editor | viewer
  status         String    @default("active") // active | suspended（停用成员：保留数据但禁止登录）
  // 平台超级管理员：**与 role 是两个正交的东西**。role 管的是「在自己租户里能干什么」，
  // 这一位管的是「能不能进跨租户运维台 /ops」。owner 再大也只是自家租户的 owner，
  // 平台侧的封禁/改套餐/改全域 AI 配置必须靠这一位，绝不能靠 role === 'owner' 判——
  // 那等于每个注册用户都是平台管理员。
  // 引导：首任管理员由 env BEACON_PLATFORM_ADMIN_PHONES 白名单授予（见 lib/ops/admin.ts），
  // 不必手工改库；之后可在 /ops 里互相授予。
  platformAdmin  Boolean   @default(false)
  // 用户选的界面外壳：workbench（按阶段排）/ taskdeck（按我要什么排）。
  // null = 还没选过，用 DEFAULT_SHELL。两种模式**功能完全对等**，差的只是按什么排，
  // 所以这里存的是偏好、不是权限，不参与任何鉴权判断。
  // 【为什么不只用 cookie】只靠 cookie 的话「我选的默认」其实只是
  // 「这台机器这个浏览器的默认」——换台电脑、清一次缓存就被拉回工作台。
  shellMode      String?
  consentAt      DateTime? // F9-8 用户同意隐私政策+服务条款的时间
  consentVersion String? // F9-8 同意时的法律文本版本号
  createdAt      DateTime  @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authSessions AuthSession[]
  topicVotes   TopicVote[]
  ingestTokens IngestToken[]

  @@index([tenantId, phone])
  apiTokens        ApiToken[]
}

// 团队成员邀请（RBAC 地基）：token 链接邀请，手机号可空表示"任何人凭链接可接受"
model Invite {
  id         String    @id @default(cuid())
  tenantId   String
  phone      String? // 被邀请人手机号；为空表示不限定接受者
  role       String    @default("editor") // owner | admin | editor | viewer
  token      String    @unique // 邀请链接 token
  invitedBy  String // memberId（发起人，不设 FK：成员删除后保留邀请审计）
  status     String    @default("pending") // pending | accepted | revoked | expired
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([phone, status])
  @@index([status, expiresAt])
}

// 短信验证码（登录/注册）
model VerificationCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  purpose   String   @default("login") // login | rebind
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// 登录会话（cookie token → member）
model AuthSession {
  id        String   @id @default(cuid())
  token     String   @unique
  memberId  String
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// 注销存根（PRD §6 F9-8：「注销流程按时序自动执行并**可审计**」）。
//
// 为什么账号注销不能只是一句 `tenant.delete()`：Tenant 一删，级联会把 PaymentOrder /
// WxPayRefund 一并带走——而《电子商务法》第 31 条要求交易信息自交易完成之日起**保存不少于三年**。
// 于是删除权（PIPL 第 47 条）与留存义务在同一张表上直接对撞。
//
// 解法是把两者拆开：**人的数据即时删除，钱的凭证去标识化后留存**。这张表存的就是后者——
// 只有商户单号/微信单号/金额/时间/档位，没有手机号、没有 openid、没有任何内容数据，
// 单看这张表无法反查到任何自然人。
//
// tenantId / memberId 留的是**已被删除的行**的 id：它们此刻只是对账线索（无从再解析成人），
// 用途是用户事后申诉「你们没删干净」时，能自证删除的时点、范围与清单。
model AccountDeletion {
  id             String @id @default(cuid())
  tenantId       String
  memberId       String
  // tenant = 所有者注销，整个工作区与全部数据删除；member = 成员退出，工作区数据留给团队
  scope          String
  plan           String @default("free")
  // 交易存根 JSON：[{outTradeNo, transactionId, plan, amountFen, status, paidAt, refunds:[…]}]
  ledger         String @default("[]")
  // 删除前的数据清单（各类条数）。事后能回答「删了什么、删了多少」，而不是只留一句「已删除」
  counts         String @default("{}")
  // 生成日志（LlmCallLog）不删、只摘除租户归属，留至法定期限届满——本字段记下被摘除的条数
  logsAnonymized Int    @default(0)

  deletedAt DateTime @default(now())

  @@index([deletedAt])
}

// 被运营的创作者账号（含人设卡）
model CreatorAccount {
  id               String   @id @default(cuid())
  workspaceId      String
  name             String
  platform         String // douyin | xiaohongshu | wechat | bilibili | x | youtube | tiktok | multi
  handle           String?
  avatar           String?
  // 人设卡（结构化 JSON：身份/受众/价值主张/内容边界/语气风格）
  personaCard      String   @default("{}")
  // 风格指纹（三层：voice/format/topic）
  styleFingerprint String   @default("{}")
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  personaVersions PersonaVersion[]
  topicIdeas      TopicIdea[]
  drafts          Draft[]
  memories        MemoryEntry[]
  publishRecords  PublishRecord[]
  advisorSessions AdvisorSession[]
  ownPosts        OwnPost[]
  advisorPersonas AdvisorPersona[]
  materials       Material[]
  reviewReports   ReviewReport[]
  dailyStats      AccountDailyStat[]
  audience        AudienceProfile[]
  publishCredentials PublishCredential[]
}

// ─────────── 账号级数据（创作者后台回填；作品级数据放不下的那部分）───────────

// 账号每日快照：粉丝数/净增/当日播放。创作者后台首页概览直接给这几个数，
// 比从作品级数据反推可靠（后台的「净增」是去重后的真实值，作品播放加总不是）。
//
// date 用 YYYY-MM-DD **字符串**而不是 DateTime：这是「逻辑日」不是时刻，
// 用 DateTime 会因时区/时分秒差异让同一天落成两条，@@unique 形同虚设。
model AccountDailyStat {
  id            String   @id @default(cuid())
  accountId     String
  platform      String // 分平台存：一个账号可能同时经营多个平台，混在一起的粉丝曲线没有意义
  date          String // YYYY-MM-DD（逻辑日）
  followers     Int? // 粉丝总数
  followerDelta Int? // 当日净增（可为负——掉粉是真实信号，不许钳 0）
  views         Int? // 当日总播放/阅读
  interactions  Int? // 当日总互动
  source        String   @default("plugin") // 与 PerformanceSnapshot.source 同一套分档口径
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account CreatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // 同账号同平台同一天只允许一条：重复回填走 upsert 更新，不堆历史垃圾
  @@unique([accountId, platform, date])
  // 粉丝曲线查询（按账号+平台取一段日期）走此索引
  @@index([accountId, platform, date])
}

// 受众画像：性别/年龄/地域/兴趣分布。变化很慢（周级），只保留最新一份 + 更新时间，
// 不做历史版本——存一堆几乎一样的快照没有信息量，需要趋势时再单开表。
// 四个字段都是 JSON 字符串 {分组名: 占比0-1}，与 Metrics.sources 同一形态。
model AudienceProfile {
  id        String   @id @default(cuid())
  accountId String
  platform  String
  gender    String   @default("{}")
  age       String   @default("{}")
  region    String   @default("{}")
  interest  String   @default("{}")
  source    String   @default("plugin")
  updatedAt DateTime @updatedAt

  account CreatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, platform])
}

model PersonaVersion {
  id        String   @id @default(cuid())
  accountId String
  version   Int
  snapshot  String // 当时人设卡 JSON
  editedBy  String?
  createdAt DateTime @default(now())

  account CreatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// 自有账号历史作品（F9-2 回溯，用于风格指纹与基线）
model OwnPost {
  id          String    @id @default(cuid())
  accountId   String
  platform    String
  title       String
  contentRef  String?
  publishedAt DateTime?
  metrics     String    @default("{}") // {views, likes, comments, shares, completion}
  createdAt   DateTime  @default(now())

  account CreatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// F3-5 经历/观点素材库：差异化生成原料（热点人人可抄，经历不可复制）
model Material {
  id        String   @id @default(cuid())
  accountId String
  type      String // experience | case | opinion | catchphrase
  content   String
  tags      String   @default("[]") // JSON string[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account CreatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, type])
}

// 灵感收集箱（F4 延伸候选源）：创作者刷到任何值得记一笔的东西，一键存进来。
//
// 存在的理由：热榜和竞对只覆盖「已经爆了的东西」，而创作者脑子里转瞬即逝的那些念头
// ——刷到的一条评论、别的赛道的一个形式、一句想反驳的话——此前没有任何落点，
// 想起来时早忘了。这张表把它变成结构化候选源，并支持「你收藏的灵感相关话题今天上榜了」的唤醒。
//
// 归属：workspace 级（小团队共享一个收集箱）；accountId 可空——插件回传时没有账号上下文，
// 网页端可以把它归到某个账号。生成推荐时取 `accountId = 本账号 或 为空` 两类。
model InspirationItem {
  id          String    @id @default(cuid())
  workspaceId String
  accountId   String? // 空 = 工作区共享，任一账号都能用
  title       String
  note        String? // 用户自己写的一句「为什么收藏它」——比标题更能说明他想做什么
  url         String?
  platform    String? // 来源平台（插件按站点给，手动录入可空）
  author      String? // 原作者/账号名
  source      String    @default("plugin") // plugin | manual
  tags        String    @default("[]") // JSON string[]
  // open 待用 | used 已转成选题 | archived 已归档（用户主动收起，不再进候选池）
  state       String    @default("open")
  createdAt   DateTime  @default(now())
  usedAt      DateTime?

  // ── 文章剪藏（群里 @机器人 发链接/长正文时抓回来的内容）──
  // ⚠️ 存的是**他人作品的正文**，与本文件原先「只存标题+链接」的口径不同，是 2026-07-29 按需求放开的。
  // 三条护栏必须一起在，缺一条这功能就成了洗稿工具：
  //   ① 只落到用户自己工作区（本表 workspaceId + RLS），不共享、不导出；
  //   ② **绝不进入生成语料池**——原句样本只取 Material(type=sample)/PublishRecord/DraftVersion(human)，
  //      剪藏正文一条都不在其中（tests/clip/never-in-exemplar.test.ts 钉死这条）；
  //   ③ UI 与机器人回执都标注来源与「仅供分析，勿直接复用文字」。
  content   String? // 正文（截断上限见 lib/clip）
  summary   String? // AI 摘要
  points    String    @default("[]") // AI 提取的要点 JSON string[]
  analysis  String? // 结合本账号人设与真实数据的分析
  clippedAt DateTime?

  // ── 读者提问（source='comment'|'rival-comment'）专用 ──
  // 被问到的累计次数（跨作品求和）
  askedCount  Int       @default(0)
  // 跨几条作品被问到：「三条作品下都在问」比「某条下问了五次」强得多
  askedWorks  Int       @default(0)
  // 幂等合并载体：JSON { workId: count }。合并语义是 max 不是 +=
  askedBreak  String    @default("{}")
  // 最近一次被问到：时效锚点 + 留存清理
  lastAskedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, state])
  @@index([workspaceId, source, state])
}

// 读者原声——评论正文逐条留存（2026-08-11 起）。
//
// ⚠️ 这张表存的是**第三方个人写下的内容**，是全库边界最紧的一张。为什么它与
// InspirationItem 的读者提问分成两张表，而不是加个字段：两者的**用途**不同，
// 因而能享有的口径也不同（长论证见 lib/comment-collect-rules.ts）：
//   · InspirationItem 的提问会进选题候选池、喂进 AI 上下文 → 必须是「≥2 人问过的共同疑问」；
//   · ReaderComment 只被用户本人阅读 + 做聚合统计 → 可以逐条留存，但换来四条护栏。
// 混成一张表，迟早有人把这里的正文顺手喂进生成链路，那道论证就没了。
//
// 不采清单（回传结构里根本没有这些字段，不是「取了不存」）：
//   评论者昵称 / 头像 / 主页链接 / 用户 ID / IP 属地 / 评论时间 / 点赞数 / 楼层回复关系 / @提及。
// 因此本表**没有任何指向评论者个人的列**——author 存的是作品作者，见下。
model ReaderComment {
  id          String @id @default(cuid())
  workspaceId String
  accountId   String? // 自有作品时归属账号；竞对作品为空。空 = 工作区共享（同 InspirationItem 语义）
  platform    String
  scope       String // own（自有作品）| rival（竞对作品）

  // 这条作品**作者**的 handle——不是评论者的（本表没有评论者的任何标识）。
  // 唯一用途与 InspirationItem.author 相同：让「被监控账号申请移除」能精确删掉
  // 这一个账号名下的评论，而不是按平台把所有人的一起清空。
  author String?

  // 与 InspirationItem.askedBreak 的 key **同一口径**：platformItemId ?? `sha:<标题哈希>` ?? 'unknown'。
  // 两边必须一致，否则 /data 作品行上「提问」和「原声」会各挂各的，同一条作品对不上。
  // ⚠️ 非空且有默认值是为了唯一索引能生效：可空列在唯一索引里 NULL≠NULL，
  // 作品 ID 采不到时同一条评论每采一次就重复插一行。
  workKey   String  @default("unknown")
  workTitle String?

  text String // 评论正文（长度上限 MAX_COMMENT_TEXT_LEN，超出在插件端截断）
  // 粗分类，只用于「粉丝在关心什么」的占比展示：question | demand | praise | complaint | other。
  // 是启发式判断，不是事实断言——UI 上必须说成「大致分类」。
  kind String @default("other")
  // 正文的归一化哈希，唯一索引用。放列里而不是直接对 text 建唯一索引：
  // text 可能到 300 字，长文本索引在 Postgres 上有 btree 尺寸限制。
  textHash String

  collectedAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // 同一条作品下同一句话只留一行：重复采集是覆盖不是累加（同 askedBreak 的 max 语义）
  @@unique([workspaceId, platform, workKey, textHash])
  @@index([workspaceId, scope, collectedAt])
  @@index([workspaceId, platform, workKey])
  // 保留期清理（COMMENT_TEXT_PURGE_DAYS）按时间扫全表，不带 workspaceId
  @@index([collectedAt])
}

// 媒体资产（域14 · AI 封面）：用户上传的参考图与生成出来的封面。
//
// 【为什么要有这张表】此前封面「过手不留」：生成的图只在浏览器 state 里，刷新即丢；
// 人像参考图每出一张封面都要重传一次。落库之后才有「本稿封面」历史与「我的形象」小库。
//
// 【为什么 bytes 直接进库、不上对象存储】项目至今没有对象存储密钥，容器无 volume、
// 蓝绿双实例重建即丢，写本地盘等于写了个必然消失的地方。数据库在托管 Postgres 上，
// 不占应用服务器根盘。代价是 pg_dump 会把图片一起备份（每 1GB 图 ≈ 11 份备份），
// 所以配额是硬的（lib/cover/rules.ts），且封面历史有保留期。
// 表大到 2GB 量级时把 bytes 换成 storageKey 迁对象存储，读路径 /api/media/[id] 不用改。
//
// 【加密】kind=portrait/background/brand 是用户上传的照片（人像属敏感个人信息），
// 落库前过 encryptBytes；kind=cover 是 AI 生成的成品图，明文存（它本来就要给用户下载/分享）。
model MediaAsset {
  id          String  @id @default(cuid())
  workspaceId String
  // 归属账号：形象库按账号分（不同账号可能是不同的人）；封面跟着草稿走时也记一份便于合并/删除
  accountId   String?
  // 这张图挂在哪篇草稿名下（仅 kind=cover）。草稿删除时置空而非连带删——
  // 用户可能已经把这张封面存进形象库当素材了，不该因为删草稿就没了。
  draftId     String?

  // portrait（人像/主体）| background（背景空镜）| brand（品牌元素）| cover（生成的封面）
  kind String
  mime String
  // 图片字节。portrait/background/brand 为 encryptBytes 后的密文（iv|tag|密文），cover 为明文。
  data     Bytes
  encrypted Boolean @default(false)
  // 原始字节数（明文长度）。配额统计用，不必解密就能算。
  size     Int
  width    Int?
  height   Int?

  // 生成参数与来源（仅 cover）：{styleKey, specKey, fontKey, decors, mainTitle, subTitle, imagePrompt, model, source, aigcProduceId}
  meta String @default("{}")

  // 用户给这张素材起的名字（形象库列表显示用）
  label String?
  // 用户把它钉在形象库里：钉住的不进保留期清理
  pinned Boolean @default(false)

  // 上传人像时勾选「本人或已获单独同意」的时间与当时的政策版本（PIPL 单独同意的留痕）
  consentAt      DateTime?
  consentVersion String?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind, createdAt])
  @@index([workspaceId, draftId])
  // 保留期清理按时间扫全表，不带 workspaceId（同 ReaderComment 的口径）
  @@index([createdAt])
}

// 「我的风格库」：用户自己写的封面风格（域14）。
//
// 内置风格是 lib/cover/styles.ts 里的数据（全租户共享）；这张表是**用户自己攒的**那些——
// 他心里有一个具体的样子（「我那种黑底金字、右下角留白的系列封面」），内置 16 档里没有。
// description 是他自己写的一句话，**原样进提示词**，不替他 AI 扩写：扩写要花钱、会走样，
// 而且他明明已经说清楚要什么了（见 lib/cover/prompt.ts 的 customStyle）。
model CoverStylePreset {
  id          String @id @default(cuid())
  workspaceId String
  name        String // 用户起的名字，显示在风格网格里
  description String // 画面描述，原样进提示词
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}


// ─────────────────────────── 域2：竞对监控（全局共享）───────────────────────────

// 全局共享，无 tenantId：同一竞对被 N 个租户订阅只采一次
model CompetitorAccount {
  id            String    @id @default(cuid())
  platform      String
  handle        String
  name          String
  avatar        String?
  followers     Int       @default(0)
  bio           String?
  lastCrawledAt DateTime?
  createdAt     DateTime  @default(now())

  posts          CrawledPost[]
  watchlistItems WatchlistItem[]
  dailyStats     CompetitorDailyStat[]

  @@unique([platform, handle])
}

// 竞对账号级的逐日快照（粉丝数等只有「当前值」的字段的历史）。
//
// 【为什么必须单独建表】CompetitorAccount.followers 是**覆盖写**的单值：每采一次就把上次
// 的数字盖掉，于是「这个竞对这周涨了多少粉」在库里根本无从查起——只能看到此刻是多少。
// 作品级有 PostMetricSnapshot 撑着，账号级此前是一片空白。
//
// 跟随竞对域的既有约定：**全局共享、不带 workspaceId、不启用 RLS**（同一竞对被 N 个租户
// 订阅只采一次，见 CompetitorAccount 上方注释与 prisma/postgres/02-rls.sql 第 4 行）。
//
// 按「逻辑日」去重：同一竞对同一天多次采集只保留一条（upsert 覆盖成当天最后一次观测），
// 与 AccountDailyStat 同口径，避免一天点十次采集就堆十行垃圾。
model CompetitorDailyStat {
  id           String   @id @default(cuid())
  competitorId String
  date         String // YYYY-MM-DD（逻辑日，按 Asia/Shanghai 折算，见 lib/insight/growth-store.ts）
  followers    Int? // 粉丝总数；采不到就是 null，不许写 0 冒充
  posts        Int? // 当时在库的作品数
  totalViews   Int? // 在库作品的播放合计；平台不给播放量时为 null
  totalLikes   Int?
  totalComments Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  competitor CompetitorAccount @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, date])
  @@index([competitorId, date])
}


// F9-4 被监控账号移除申请：处理已公开个人信息的权利人拒绝权（PIPL）。
// 全局无租户——竞对档案全局共享，申请也针对全局档案。
model DataRemovalRequest {
  id       String @id @default(cuid())
  platform String
  handle   String // 被监控账号主页标识/链接；kind=comment 时存的是**作品链接**，见下
  contact  String // 申请人联系方式（邮箱/手机）
  reason   String?

  // 申请人是谁 —— 决定这条申请**执行什么**，两者绝不能混（2026-08-24 加）：
  //   · account（默认，原有全部行）—— 被监控账号的权利人。停采该账号 + 删它名下全部数据。
  //   · comment                    —— 在别人作品下留言的**读者本人**，主张删掉自己那一条评论
  //                                   （《个保法》第 27 条拒绝权 / 第 47 条删除权）。
  //
  // ⚠️ comment 类**绝不能**进停采闸（isRemovalRequested 的 BLOCKING_STATUSES 查询）。
  // 理由：评论者填的 handle 是**作品作者**的账号，不是他自己的。放进闸里等于
  // 「张三删掉自己在李四视频下的一条评论」→ 全平台停采李四并删光李四的档案。
  // 这是拿一个人的权利去伤害另一个人，比不执行更坏。
  kind String @default("account")

  // kind=comment 时申请人填的评论原文，用于精确定位要删的那一行 ReaderComment。
  // 上限与 MAX_COMMENT_TEXT_LEN 同为 300：申请人抄不出比我们存得更长的正文。
  commentText String?

  status     String    @default("pending") // pending | verified | removed | rejected
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([platform, handle])
  // 停采闸按 (platform, handle, status) 查，加了 kind 过滤后走这条
  @@index([kind, status])
}

// 租户对竞对的订阅关系
model WatchlistItem {
  id           String   @id @default(cuid())
  workspaceId  String
  competitorId String
  label        String?
  addedAt      DateTime @default(now())

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  competitor CompetitorAccount @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, competitorId])
}

// 全局共享作品
model CrawledPost {
  id             String    @id @default(cuid())
  competitorId   String
  platform       String
  platformItemId String
  title          String
  summary        String?
  url            String?
  publishedAt    DateTime?
  metrics        String    @default("{}") // {views,likes,comments,shares,collects}
  hotScore       Float     @default(0)
  crawledAt      DateTime  @default(now())

  competitor CompetitorAccount    @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  snapshots  PostMetricSnapshot[]

  @@unique([platform, platformItemId])
  // 竞争饱和度取数（saturation.ts）按发布/采集时间过滤近 72h 全局作品，两列都要走时间窗口
  @@index([publishedAt])
  @@index([crawledAt])
}

model PostMetricSnapshot {
  id      String   @id @default(cuid())
  postId  String
  metrics String   @default("{}")
  takenAt DateTime @default(now())
  // 这一次观测是**从哪种页面**采来的。不同页面给的字段天差地别：
  //   home   账号主页/列表页 —— 抖音这类平台只给得到点赞
  //   detail 作品详情页 —— 评论/收藏/转发只有这儿有
  //   server 服务端定时/RSS   import 文件导入
  // 不标来源的话，同一条作品的快照序列会在「只有点赞」和「四项齐全」之间反复横跳，
  // 用户看到的是一条读不懂的记录：分不清是平台改了、还是这次换了种采法。
  // 自有侧的 PerformanceSnapshot 早就有 source，竞对侧此前是漏的。
  source  String   @default("home")

  post CrawledPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  // 竞对作品趋势查询（按作品取快照、按 takenAt 排序）走此索引
  @@index([postId, takenAt])
}

// ─────────────────────────── 域3：热榜（全局广播型）───────────────────────────

model HotItem {
  id          String   @id @default(cuid())
  source      String // douyin | weibo | x | bilibili | zhihu | baidu | toutiao | youtube | xiaohongshu
  rank        Int
  title       String
  url         String?
  heat        Float    @default(0)
  extra       String   @default("{}")
  isMock      Boolean  @default(false) // true=兜底示例数据（无真实源或采集失败），UI 标注
  clusterId   String?
  fetchedAt   DateTime @default(now())
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  peakRank    Int?
  peakHeat    Float?
  lifecycle   String   @default("rising") // rising | peak | cooling | faded

  cluster TopicCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  @@unique([source, title])
  @@index([source, fetchedAt])
}

// 跨源话题聚类（LLM 产物，全租户共享）
model TopicCluster {
  id          String   @id @default(cuid())
  title       String
  summary     String?
  sources     String   @default("[]") // JSON: 涉及的源
  heat        Float    @default(0)
  category    String   @default("general")
  isSensitive Boolean  @default(false) // 敏感社会/政治话题：可看但不进推荐/生成
  lifecycle   String   @default("rising") // rising | peak | decay
  createdAt   DateTime @default(now())

  hotItems HotItem[]
}

// ─────────────────────────── 域4：选题与创作 ───────────────────────────

model TopicIdea {
  id            String   @id @default(cuid())
  accountId     String
  title         String
  angle         String // 差异化切入角（LLM 精排强制输出）
  // 切入角的答案结构：definition | comparison | list | process | judgment（口径见 lib/topic/scoring.ts）。
  // null = 没判定（老数据、模型返回 other 或集合外的值、JSON 解析失败、或这条被判「硬凑」不推荐），
  // **不是**某个默认形状——空着比按一个错标签便宜。
  angleShape    String?
  rationale     String?
  // 六维评分 JSON: {traffic, personaFit, cost, monetization, compliance, differentiation}
  scores        String   @default("{}")
  totalScore    Float    @default(0)
  // hot | competitor | advisor | manual：原有四种，来源于「别人已经做爆的东西」。
  // gap | recycle | crossplat | evergreen：延伸候选源（lib/topic/sources/），分别是
  // 跨平台时间差抢跑、旧文话题回温、A 平台爆款未发 B 平台、赛道常青储备。
  sourceType    String   @default("hot")
  sourceRef     String?
  // 时间队列（lib/topic/queue.ts）：today 今日突击 | week 本周窗口 | evergreen 常青储备。
  // 解决「所有推荐平权」——「现在不做就没了」和「何时做都行」不该混在一个列表里。
  queue         String   @default("today")
  // 「为什么是你 / 为什么是现在」的事实证据（由候选源产出，非 LLM 编造）。
  // 落库是为了 UI 能把推荐理由摊开给人看，而不只是给模型看完就扔。
  evidence      String?
  // 时间窗口人话提示，如「微博已上榜 6 小时，抖音尚未出现 · 抢跑窗口约 30 小时」
  windowHint    String?
  // 蓝海度 0-1（lib/topic/bluesea.ts）：需求代理（在榜时长 × 跨平台扩散）× 供给还空着。
  // null = 该候选拿不到热榜时间线（竞对/自搬运/常青/日历），不是「蓝海度为 0」——两者要能分开。
  blueSea       Float?
  // 七态状态机: candidate | recommended | accepted | rejected | drafting | published | reviewed
  state         String   @default("candidate")
  rejectReason  String?
  isExploration Boolean  @default(false) // 探索位
  // 评分是否由 Mock LLM 产生（与 HotItem.isMock 同约定）：UI 必须标注，杜绝伪随机分装真
  mocked        Boolean  @default(false)
  // mocked=true 的两种成因必须分开，否则界面只能二选一地说错话：
  //   degraded=false → 压根没接真模型（dev/未配 Key），文案是「未接入真实 AI」，重试无意义；
  //   degraded=true  → 接了真模型但这次调用失败/超时被 Mock 兜底，文案是「AI 调用失败」，且要给重试入口。
  // 真机 2026-07-30：接着 MiniMax 跑推荐，两条因 30s 超时降级，卡上却写「未接入真实 AI」。
  degraded      Boolean  @default(false)
  createdAt     DateTime @default(now())

  account CreatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  drafts  Draft[]
  votes   TopicVote[]
}

// 团队选题投票：多成员工作区里，对候选选题表态「想做 / 不想做」。
//
// 【它刻意不进算法】票数是**人的协调信号**，不是质量信号——三个人都想做不代表它会火。
// 所以投票只影响页面上的展示与排序参考，绝不喂进六维评分或粗排权重。
// 把「团队偏好」混进「内容潜力」的分里，等于用一个不可验证的东西污染一个可验证的东西。
//
// 一人一票，改票即覆盖（@@unique）；成员被删则票一并删（onDelete: Cascade），
// 不留下无法归属的幽灵票。
model TopicVote {
  id        String   @id @default(cuid())
  topicId   String
  memberId  String
  // up 想做 | down 不想做。不做「弃权」态——不投票本身就是弃权。
  value     String   @default("up")
  note      String? // 一句话理由（选填），团队沟通用
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic  TopicIdea @relation(fields: [topicId], references: [id], onDelete: Cascade)
  member Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([topicId, memberId])
  @@index([topicId])
}

model Draft {
  id            String   @id @default(cuid())
  accountId     String
  topicId       String?
  title         String
  platform      String // 目标发布平台
  // editing | checking | ready | published | abandoned（W-4：起了初稿长期未完成；用户再生成初稿会回到 editing）
  status        String   @default("editing")
  // 一稿多平台：派生稿指向它的原稿。
  // 为什么不复用 topicId 做血缘：用户自己粘进来的稿子压根没有选题（topicId 为空），
  // 而「同一篇的多平台版本」恰恰是这类稿件最常见的需求。SetNull 而非 Cascade——
  // 删掉原稿不该连坐已经派生出去、可能已经发布的兄弟稿。
  parentDraftId String?
  // 这篇稿子选定的封面（MediaAsset.id）。刻意不建外键关系：封面被清理/删除时这里就是一个
  // 查不到的 id，读的时候查不到当没有即可——建了外键反而要为「删一张封面」维护一条级联。
  coverAssetId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account  CreatorAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  topic    TopicIdea?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  parent   Draft?            @relation("DraftDerive", fields: [parentDraftId], references: [id], onDelete: SetNull)
  children Draft[]           @relation("DraftDerive")
  versions DraftVersion[]
  checks   ComplianceCheck[]

  @@index([parentDraftId])
}

model DraftVersion {
  id           String   @id @default(cuid())
  draftId      String
  seq          Int
  authorType   String // ai | human
  content      String
  diffFromPrev String?
  createdAt    DateTime @default(now())

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── 域5：合规 ───────────────────────────

model SensitiveWord {
  id         String   @id @default(cuid())
  tenantId   String? // null=全局词库(法律/平台/行业)，非null=租户自定义(L4)
  word       String
  tier       String // legal | platform | industry | custom
  platform   String? // 平台级词命中的平台，legal 级为空
  action     String   @default("warn") // block | warn | suggest
  suggestion String?
  category   String?
  version    String   @default("2026.07")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([tier, platform])
}

model ComplianceCheck {
  id        String   @id @default(cuid())
  draftId   String
  platform  String
  // 命中项 JSON 数组: [{word,tier,action,start,end,suggestion}]
  hits      String   @default("[]")
  riskLevel String   @default("pass") // pass | warn | block
  checkedAt DateTime @default(now())

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

// F6-8 合规误报反馈/申诉
model ComplianceFeedback {
  id         String    @id @default(cuid())
  tenantId   String
  word       String
  tier       String
  context    String // 命中时的原文上下文
  reason     String // 用户反馈原因
  status     String    @default("pending") // pending | accepted | rejected
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// ─────────────────────────── 域6：记忆 ───────────────────────────

model MemoryEntry {
  id          String    @id @default(cuid())
  workspaceId String
  accountId   String?
  type        String // persona | preference | performance | fact
  content     String
  confidence  Float     @default(0.5) // 置信度分级注入
  hitCount    Int       @default(1) // 同类行为累计次数
  active      Boolean   @default(true)
  embedding   String? // JSON float[]（开发态 JS 内算余弦）
  validFrom   DateTime  @default(now())
  validTo     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   CreatorAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([workspaceId, type])
}

// ─────────────────────────── 域7：发布与回流 ───────────────────────────

model PublishRecord {
  id             String   @id @default(cuid())
  accountId      String
  topicId        String?
  draftId        String?
  platform       String
  title          String?
  contentText    String? // 发布时定稿正文，支持随时重新复制回去二次分发
  platformItemId String?
  // 无 platformItemId = 自动回流（jobs/handlers.ts backfill_metrics 靠它挑记录）不可用。
  // 恒等于 platformItemId==null，写入时同步不许漂移；单列出来是为了 /data 顶部能一次 count
  // 出「N 篇缺链接学不到数据」并给补链接入口。
  needsBackfill  Boolean  @default(false)
  publishedAt    DateTime @default(now())
  metrics        String   @default("{}")
  fromRecommend  Boolean  @default(false) // 归因：是否来自产品推荐

  account   CreatorAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  snapshots PerformanceSnapshot[]

  // 同账号同作品ID只允许一条：登记发布与数据回填两个入口 upsert 到同一条，
  // 不再各建一条污染 learn 基线与 /data 统计。platformItemId=null 因 SQL 中 NULL 互异
  // 不受此约束（缺链接的记录本就无法按作品ID去重，各自独立）。
  @@unique([accountId, platformItemId])
}

model PerformanceSnapshot {
  id        String   @id @default(cuid())
  publishId String
  metrics   String   @default("{}")
  takenAt   DateTime @default(now())
  // 来源标记：与 HotItem.isMock 的约定一致——非用户手填的数据要能在 UI 上标出处，
  // 否则手填值和适配器拉的真实值会混在同一条趋势曲线里，看不出哪个可信。
  source    String   @default("manual") // manual | plugin | wechat-datacube | tikhub | youtube-official | twitterapi-io | newrank | bilibili-public
  milestone String? // D+1..D+7 | D+14 | D+30（自动回流逐日里程碑；手动/插件回填为 null）

  publish PublishRecord @relation(fields: [publishId], references: [id], onDelete: Cascade)

  // 单篇逐日趋势查询（按发布记录取快照、按 takenAt 排序做时序）走此索引，避免全表扫
  @@index([publishId, takenAt])
}

// 站内通知（触达兜底）。外部机器人(pushEvent)只在用户配了 feishu/wecom 等 webhook 时可达；
// 个人创作者未必配，站内红点是人人可见的通用触达。独立表、无 FK（通知是易失数据，孤儿无害）。
model Notification {
  id          String   @id @default(cuid())
  workspaceId String
  accountId   String? // 关联账号（可空=工作区级）
  kind        String // performance_alert | review_ready | weekly_review | ...
  // 这条只给某个人看吗（null = 工作区里人人可见，旧行为）。
  //
  // 【为什么需要】「等你确认」只有发起人点得动，而红点是工作区级的——
  // 不定向的话，同事也会看到一条他推不动的通知。
  memberId    String?
  refId       String? // 关联对象（如 publishId），用于同一对象去重
  title       String
  body        String   @default("")
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([workspaceId, read, createdAt])
}

// AI 复盘报告（单篇 D+7 / 周度）。refId 对单篇=publishId，松引用不建 FK（发布记录可能被删，复盘留档）。
// content 存结构化 JSON（表现判定/曲线归因/建议）；可重跑留历史。Mock 产物标注不入记忆。
model ReviewReport {
  id        String   @id @default(cuid())
  accountId String
  kind      String // article | weekly
  refId     String? // 单篇=publishId
  period    String? // 周度报告的周标识
  content   String   @default("{}")
  mocked    Boolean  @default(false)
  createdAt DateTime @default(now())

  account CreatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, kind, createdAt])
}

// ─────────────────────────── 域8：智囊团（F10）───────────────────────────

model AdvisorSession {
  id        String   @id @default(cuid())
  accountId String
  trigger   String   @default("manual") // manual | cold_start | repeated_reject | draft_review(W-6 草稿会诊)
  topicSeed String?
  // W-6：草稿会诊场次指向的草稿（松引用，草稿删了仍保留会诊记录）。选题方向会诊为 null
  draftRef  String?
  status    String   @default("done") // running | done
  summary   String?
  createdAt DateTime @default(now())

  account  CreatorAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  opinions AdvisorOpinion[]
}

model AdvisorOpinion {
  id          String   @id @default(cuid())
  sessionId   String
  // 人物卡快照
  personaKey  String // 人物标识
  personaName String
  personaRole String // audience | expert
  stance      String // 该人物的立场/关注点
  suggestion  String // 选题方向
  rationale   String?
  adopted     Boolean? // 用户检验结果：采纳/拒绝
  createdAt   DateTime @default(now())

  session AdvisorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// 智囊团人物卡：账号级可自定义身份 + 采纳/否决自学习权重
model AdvisorPersona {
  id            String   @id @default(cuid())
  accountId     String
  key           String // 稳定标识：内置沿用 builtin key，自定义为 custom_<cuid>
  name          String
  role          String // audience | expert
  emoji         String   @default("🧑")
  stance        String // 一句话世界观/立场
  focus         String   @default("[]") // JSON string[]：打分时的注意力分配
  source        String   @default("builtin") // builtin | custom
  enabled       Boolean  @default(true)
  weight        Float    @default(1) // 自学习权重 0.3–2.0（采纳加权/否决减权）
  adoptedCount  Int      @default(0)
  rejectedCount Int      @default(0)
  learnedNotes  String   @default("[]") // JSON [{verdict, text, at}]：采纳/否决沉淀的经验，注入下次发言
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account CreatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, key])
}

// ─────────────────────────── 域9：算法教练（F11）───────────────────────────

model AlgorithmRule {
  id          String   @id @default(cuid())
  platform    String
  signal      String // 排序信号，如 completion_rate / ces_score
  weight      Float    @default(0.5)
  advice      String // 建议模板
  contentType String   @default("all") // short_video | image_text | article | long_video | all
  confidence  String   @default("consensus") // official | opensource | consensus | rumor
  version     String   @default("2026.07")
  source      String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([platform, contentType])
}

// ─────────────────────────── 域10：BYOK 多模型（F12）───────────────────────────

model ModelProvider {
  id        String   @id @default(cuid())
  tenantId  String
  label     String
  // 白名单七家，**没有 custom**：端点由平台锁定，不开放自定义（PRD §6 F12-1 / §10.5 L3）。
  // 唯一事实来源是 lib/constants.ts:LLM_VENDORS，入库存的是预置 baseUrl 而非用户提交值。
  vendor    String // deepseek | qwen | kimi | glm | openai | claude | gemini
  baseUrl   String
  apiKeyEnc String // 加密存储（开发态用可逆脱敏占位）
  model     String
  region    String   @default("cn") // cn(已备案) | overseas
  // 按功能路由：JSON {scoring, generation, advisor, compliance, chat}
  routing   String   @default("{}")
  isDefault Boolean  @default(false)
  status    String   @default("untested") // untested | ok | failed
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── 域11：任务与助手（F8）───────────────────────────

model TaskItem {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  done        Boolean  @default(false)
  source      String   @default("user") // user | suggestion
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── 域12：可观测性 / 成本账本 ───────────────────────────

// 每次 LLM 调用记账（单租户单位经济仪表盘，毛利护栏；逆向预演 D5）
model LlmCallLog {
  id               String   @id @default(cuid())
  tenantId         String?
  fn               String // scoring | generation | advisor | compliance | chat | embed
  provider         String
  model            String
  mocked           Boolean  @default(false)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costUsd          Float    @default(0)
  // 这笔钱谁出的：platform=平台垫付 | byok=用户自己的 Key | mock=没花钱 | unknown=本列加上之前的历史行。
  // 平台预算闸（lib/ops/platform-config.ts）只数 platform 那部分——把用户自付的钱算进平台预算，
  // 会让预算莫名其妙提前烧完，且越是重度 BYOK 用户越早把别人拦死。
  // 历史行一律 unknown 而不是默认 platform：不知道就说不知道，别拿猜的数当账。
  source           String   @default("unknown")
  // 这次调用属于哪一次 AI 执行（AgentRun.id）。空 = 不是执行器发的（网页聊天、打分、生成…）。
  //
  // 【为什么不靠 fn 区分】fn 不只是记账字段，它还是 **BYOK 按功能路由的键**
  // （lib/llm/gateway.ts 按 routing[fn] 选渠道、按 functions[fn] 覆盖温度）。
  // 把执行器的调用改成 fn='agent' 会让所有只配了 'chat' 路由的存量租户静默换渠道，
  // 没配默认渠道的直接落 Mock——而 Mock 在执行器里是硬停 failed。加一列比动路由键安全得多。
  //
  // 松引用不加外键：账本是只增不减的事实记录，不该被运行记录的到期清理级联带走。
  runId            String?
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@index([source, createdAt])
  // 「这次执行烧了多少次调用」——执行循环每轮按它数一次，必须走索引
  @@index([runId])
}

// 后台任务执行记录（三轨编排的可观测性）
model JobRun {
  id         String    @id @default(cuid())
  name       String // ingest_hot | cluster_topics | crawl_competitors | daily_recommend | backfill_metrics
  track      String // broadcast | batch_tenant | event
  status     String    @default("running") // running | ok | failed
  detail     String?
  tenantId   String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  @@index([name, startedAt])
}

// ─────────────────────────── 域14：内容技能（Skill 市场与安装）───────────────────────────
//
// 「技能」= 一段带占位符的提示词模板 + 输出契约，把选题/草稿一键转成平台成品
// （微信公众号排版、小红书图文、抖音口播稿…）。内置技能全租户可见（tenantId=null），
// 用户在技能中心自行安装/停用；自定义技能归属租户。运行走 llmComplete 网关：
// 配额、合规检测、AIGC 标识出口与其他生成路径同一套闸门，不另开后门。

model ContentSkill {
  id             String   @id @default(cuid())
  // null = 平台内置技能（种子数据灌入）；非 null = 该租户的自定义技能
  tenantId       String?
  // 内置技能用固定 slug（seed 幂等 upsert 的锚点）；自定义生成 custom-<cuid>
  slug           String   @unique
  name           String
  description    String
  emoji          String   @default("✨")
  // 目标平台：wechat | xiaohongshu | douyin | shipinhao | zhihu | generic
  platform       String   @default("generic")
  // format=排版成品 | generate=生成新内容 | check=检查类
  category       String   @default("format")
  // 提示词模板。占位符：{{content}} 正文、{{title}} 标题、{{persona}} 人设摘要。
  // 模板是数据不是代码：渲染只做字符串替换，绝不 eval。
  promptTemplate String
  // 输出形态：markdown | html | text。html 仅用于富文本排版（微信公众号粘贴）。
  outputKind     String   @default("markdown")
  // 版本号。**2026-08-21 之前这是个死字段**（恒为 "1.0"，全代码库零读写）——
  // 市场化之后它才有了含义：装的是哪一版、上游有没有新版本，全靠它比。
  // 格式统一成三段式 semver（lib/market/pack.ts 的 compareVersion 按段比）
  version        String   @default("1.0.0")
  // ── 市场溯源（只有从市场/网址装进来的才有）──────────────────────────────
  // 从哪儿装的。检查更新时回这个地址拿最新版本；**留着它也是为了能说清「这东西哪来的」**
  sourceUrl      String?
  // 包里声明的作者署名。它**不是身份凭证**（没有签名），只是展示——
  // 界面上要说清楚这一点，别让用户把它当成认证过的来源
  sourceAuthor   String?
  isBuiltin      Boolean  @default(false)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installs SkillInstall[]

  @@index([tenantId, enabled])
}

// 租户安装关系：内置技能装了才在创作工坊出现；自定义技能创建即自动安装
model SkillInstall {
  id        String   @id @default(cuid())
  tenantId  String
  skillId   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  skill  ContentSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([tenantId, skillId])
}

// ─────────────────────────── 域13：支付与订阅（微信支付 Native 扫码）───────────────────────────
//
// 产品形态：Native 扫码 + 手动续费（不做委托代扣，需额外资质）。按 plan 订阅制，
// 付费即升档、到期由 job 降回 free。配额分档见 lib/quota.ts PLATFORM_TIERS。
//
// 金额一律**整数分**（字段名以 Fen 结尾），与微信 amount.total 同单位。
// 绝不用 Float：浮点误差 + SQLite 没有真 Decimal，钱不能这么存。

model PaymentOrder {
  id           String @id @default(cuid())
  // 商户订单号：6-32 位，只允许 [0-9A-Za-z_|*-]，同一商户号下唯一（微信硬约束）。
  // 不能有中文/emoji。重试支付必须复用原单号，已支付/已关闭的单号不可再用。
  outTradeNo   String @unique
  tenantId     String
  // 下单人。不设 FK：成员删除后保留支付审计（与 Invite.invitedBy 同约定）。
  memberId     String
  plan         String // personal | team | enterprise（本单购买的档位；free 不可下单）
  periodMonths Int // 购买时长（月）：1 | 12
  amountFen    Int // 应付金额，单位：分
  currency     String @default("CNY")
  // created=已下单待支付 | paid=已支付并兑现 | closed=超时/主动关单 | refunded=已退款 | failed=下单失败
  status       String @default("created")
  provider     String @default("wxpay_native")

  codeUrl       String? // 微信返回的 weixin://wxpay/bizpayurl/... 原样转二维码，别自己拼参数
  codeExpiresAt DateTime? // 二维码失效时间（下单 +2h）。失效需重新下单换新单号。
  // 微信支付订单号。兑现幂等的**第二道锁**：同一笔支付全局唯一，
  // 挡住「回调与查单兜底并发兑现」。可空 unique（多行 NULL 在 SQLite/PG 均允许）。
  transactionId String?   @unique
  paidAt        DateTime?
  closedAt      DateTime?

  // ── 兑现审计 ──
  // 升档折算/续费叠加会让「买了 1 个月」≠「延了 30 天」。不记这些字段，
  // 事后对账说不清一单钱到底换了什么，客服无法自证。
  prevPlan          String? // 兑现前的 plan
  prevPlanExpiresAt DateTime? // 兑现前的到期时间
  grantedDays       Int? // 本单实际发放天数（含升档折算换算出的补偿天数）
  newPlanExpiresAt  DateTime? // 兑现后的到期时间

  failReason String? // 微信错误码 + message（如 NO_AUTH / OUT_TRADE_NO_USED）
  // 微信应答头 Request-ID：微信侧请求唯一标识，报障必须提供 → 必须落库
  requestId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notifies WxPayNotifyLog[]
  refunds  WxPayRefund[]

  @@index([tenantId, createdAt]) // 租户订单列表
  @@index([status, codeExpiresAt]) // 关单 job：扫 status='created' 且二维码已过期
}

// 微信支付回调去重日志。
// 微信明确会重复发同一通知（失败/超时后最多重发 15 次），且要求「做好重入设计」。
// notifyId 唯一索引是幂等的**第一道锁**：INSERT 冲突 = 重复通知 → 直接 204。
//
// 为什么两道锁都要（不是冗余）：查单兜底路径（GET /v3/pay/transactions/out-trade-no/...）
// 没有 notifyId，第一道锁对它无效，必须靠 PaymentOrder.transactionId + 条件写兜住。
// 两条不同入口共用一个兑现幂等点。
//
// 本表**不启用 RLS**：由无登录态的回调路由写入（微信要求 notify_url 不得做登录态校验），
// 拿不到 app.current_tenant，启用 RLS 会让 INSERT 被 WITH CHECK 拒掉。详见 postgres/02-rls.sql 尾注。
model WxPayNotifyLog {
  id         String   @id @default(cuid())
  notifyId   String   @unique // 回调外层 id，形如 EV-2018022511223320873
  orderId    String? // 关联订单；解密失败/匹配不到订单时为空（仍记录，便于排障）
  outTradeNo String?
  eventType  String // TRANSACTION.SUCCESS
  tradeState String? // SUCCESS | REFUND | NOTPAY | CLOSED（Native 只会出现这 4 个）
  // 业务兑现是否完成。微信要求 5s 内应答 → 先验签应答、再异步兑现，本字段是异步进度。
  processed  Boolean  @default(false)
  // 摘要而非完整报文：解密后明文含 payer.openid 等个人信息，不落全量。
  rawSummary String?
  createdAt  DateTime @default(now())

  order PaymentOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([processed, createdAt]) // 补偿 job：扫已收到但未兑现的通知
}

// 退款单。与 PaymentOrder 分表：一笔支付理论可多次部分退款（v1 只做全额），且退款有独立状态机。
// 退款回调复用 WxPayNotifyLog 去重（eventType=REFUND.SUCCESS）。
model WxPayRefund {
  id              String  @id @default(cuid())
  // 商户退款单号（bcr_ 前缀）。幂等键：重试退款必须复用同一个，否则退两次钱。
  outRefundNo     String  @unique
  orderId         String
  outTradeNo      String
  tenantId        String
  amountRefundFen Int // 退款金额（分），v1 = 原订单全额
  amountTotalFen  Int // 原订单总额（分）
  reason          String?
  // 发起人：memberId（人工客服代操作）或 'ops'（内部脚本/受控接口）。审计用。
  operator        String
  // created=已发起 | processing=微信处理中 | success=已退款并已尝试回收套餐
  // | closed/abnormal=微信侧终止 | failed=发起失败
  status          String  @default("created")
  // 微信退款单号，全局唯一 → 兑现幂等的第二道锁（同 PaymentOrder.transactionId）。
  refundId        String? @unique

  // ── 套餐回收审计 ──
  // 退款成功后是否安全回收了套餐（仅当退款时租户档位仍等于本单兑现结果时才回收，
  // 否则说明其上叠加过后续购买，回收会误伤 → 不回收、只退钱，留 planRecovered=false 待人工）。
  planRecovered          Boolean   @default(false)
  recoveredPlan          String? // 回收后写回的 plan
  recoveredPlanExpiresAt DateTime? // 回收后写回的到期时间

  successAt  DateTime?
  failReason String?
  requestId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  order PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
  @@index([tenantId, createdAt])
}


// ─────────────────────── 域15：平台运维（跨租户超管台 /ops）───────────────────────

// 超管操作审计：谁、什么时候、对哪个租户做了什么。
// **不设外键、不做 RLS**：它记的正是跨租户动作，且被操作对象（租户/成员）可能随后就被删除——
// 留痕要比被留痕的对象活得久，这是审计的意义所在。
model AdminAuditLog {
  id            String   @id @default(cuid())
  actorMemberId String // 操作人 Member.id（不做外键，成员删了也要留痕）
  actorName     String
  action        String // 动作 key，唯一事实来源见 lib/ops/audit.ts
  targetType    String // tenant | member | provider | setting | parser
  targetId      String
  targetLabel   String @default("")
  detail        String @default("{}") // JSON：{before, after, note}
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([actorMemberId, createdAt])
  @@index([targetType, targetId])
}

// 平台级默认模型渠道（超管配置）。与 ModelProvider（租户 BYOK）字段同形但**刻意分表**：
// 混在一张表里就得靠一个「tenantId = 特殊值」的哨兵值来区分，而 ModelProvider 上有 RLS 策略，
// 哨兵行会在租户会话里被策略挡掉——读侧永远拿不到平台默认，症状是「配了没生效」。
//
// 优先级（lib/llm/gateway.ts 的唯一口径）：租户 BYOK → 平台渠道（本表）→ env → Mock。
// env 保留为兜底：库还没建表/还没配时不能让整个站的 AI 全哑。
model PlatformProvider {
  id        String   @id @default(cuid())
  label     String
  vendor    String
  baseUrl   String
  apiKeyEnc String // 与 ModelProvider 同一套 lib/crypto 加密，绝不明文
  model     String
  region    String   @default("cn") // cn | overseas
  routing   String   @default("{}") // 按功能路由：{"scoring":true,...} 命中即这条渠道接管该功能
  isDefault Boolean  @default(false)
  enabled   Boolean  @default(true)
  status    String   @default("untested") // untested | ok | failed
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 平台级键值配置（超管改，全站生效）。value 存 JSON 字符串。
// 只一张表、按 key 分区，是因为这类配置的形状会随功能长——每加一组就加一张表，
// 迁移成本会压过收益。key 的清单与解析口径收在 lib/ops/platform-config.ts。
model PlatformSetting {
  key       String   @id
  value     String // JSON
  updatedBy String? // Member.id
  updatedAt DateTime @updatedAt
}


// ─────────────────────── 域16：AI 全域调用（工具执行器）───────────────────────
//
// 一次「让 AI 去把这件事做了」的完整过程。messages 存整段对话（含工具调用与回灌结果），
// 这样一次运行可以中途停下等用户确认、几分钟后再从原样的上下文继续——
// 不存的话，「确认」之后模型就失忆了，只能重跑一遍（还可能做出不一样的决定）。
model AgentRun {
  id          String   @id @default(cuid())
  workspaceId String
  accountId   String? // 运行时所在的创作账号（工具按它取人设/数据）
  memberId    String // 发起人。**权限按他算**，不是按工作区里权限最大的人算
  goal        String // 用户那句话
  // queued=排队中（这个工作区同时在跑的已经到上限了，等前面的让位）
  // | running=模型正在想 | awaiting_confirm=等用户点确认写操作
  // | waiting_browser=派了活给浏览器插件、停下来等它回来（见 waitingOn）
  // | waiting_quota=今日额度用尽，等北京时间 0 点重置后自动接着跑（见 quotaResumeAt）
  // | done | failed | cancelled
  //
  // 【状态只能经 lib/agent/run.ts 的 transition() 改】它用带 from 条件的 updateMany 做乐观锁迁移。
  // 直接 update 会把并发发生的终态（最典型：用户点了「终止」）悄悄盖回去——
  // 用户看到的是「我明明点了终止，它却变成了已完成」。
  status      String   @default("running")
  messages    String   @default("[]") // JSON: ChatMessage[]（含 tool 角色）
  // JSON: **停在哪一次 ToolCall 上**。awaiting_confirm 时是「等你点头的那次」，
  // waiting_browser 时是「等结果的那次」——两种停都要靠它在恢复时把结果回灌给模型
  pending     String?
  // 在等一件什么外部的事，格式 `<类型>:<id>`，目前只有 `browser:<BrowserTask.id>`。
  // 那件事有了结果（完成/失败/过期/取消）就回来叫醒这次运行（lib/agent/wake.ts）
  waitingOn   String?
  // 执行租约。后台跑这次运行的那个进程持有它，到期未续=那个进程没了，别人可以接手。
  // 没有它的话，「确认」点两下、或插件回执重投一次，同一次运行会被两个地方同时往前推
  leaseUntil  DateTime?
  // waiting_quota 时：什么时候可以再试（北京时间次日 0 点）。定时扫它决定叫醒谁。
  // 只对「等一等真的会好」的日额度有意义——月度/平台预算超限一律如实判 failed，不挂在这里。
  quotaResumeAt DateTime?
  // 从群机器人派出来的话，记下「回哪儿」：`<provider>:<integrationId>:<chatId>`。
  // 终态/等确认时把回执发回那个群（lib/bot/dispatch.ts），/任务 /终止 也按它圈定本群的运行。
  botChatRef  String?
  answer      String? // 最终回答
  error       String?
  // 【steps 与 rounds 是两个数，别再混用】
  // steps  = 步骤流水的条数，同时是 AgentStep.seq 的来源（tool_call、tool_result、answer 各占一条）
  // rounds = **模型真的说了几轮话**，封顶判的是它
  // 早先只有 steps 一个数，注释写着「已消耗的模型轮数」却拿流水条数去判封顶——
  // 一轮调一次工具就吃掉两条，写着 12 轮的上限实际约等于 6 次工具调用。
  steps       Int      @default(0)
  rounds      Int      @default(0)
  // 激活段：这次运行被「叫起来跑」的第几回合。通知去重键的一部分——
  // 同一段里同一个状态只叫一次，新的一段重新开始算。
  // 现在恒为 0；等追问/接着跑做出来（同一条运行会 done → running → done 走第二遍），
  // 它才会递增。**先建在这里是为了让去重键从一开始就是对的**：
  // 只按 (runId, status) 去重的话，那时候第二次跑完就静默不通知了——
  // 而追问的人恰恰是最想知道「又跑完了」的那个。
  episode     Int      @default(0)
  // 这次执行的授权档：
  //   confirm_each（缺省）= 每个会改数据或花钱的动作都停下来问
  //   preauthorized       = 派发时用户勾定了一批工具，那些不再逐个问（见 preauthorizedTools）
  //   unattended          = 无人值守（只有定时/预设任务能配），但**签合约类工具照样停**
  //
  // 【它只能由发起人在派发时的页面动作写入】模型说什么都不算数：needsConfirm 判的是
  // 库里这两列，不是对话里的任何声明。对外 API/MCP 建的运行一律强制回 confirm_each。
  authMode    String   @default("confirm_each")
  // JSON: string[]，预授权勾定的工具名。**只在 authMode=preauthorized 时有意义**
  preauthorizedTools String @default("[]")
  // 这次执行最多能烧多少次模型调用。**数的是调用次数不是轮数**——
  // 一个 costly 工具内部可能一次就调十几次（十几席会诊、八条选题精排），
  // 按轮数封顶等于没有封顶。实际用量按 LlmCallLog.runId 现算。
  callBudget  Int      @default(30)
  // 这次执行是谁发起的：manual=用户在页面上派的 | preset=一键任务 | schedule=定时 | api=对外调用
  // api 那种**强制 confirm_each**（防「模型 A 起草、模型 B 代签」换个皮再来一次）
  origin      String   @default("manual")
  // 哪个自主智能体在跑这次执行（null = 通用助手）。松引用不加外键：
  // 模板被删掉之后这条运行记录仍然有价值
  agentTemplateId String?
  // JSON string[]：这次**只许用**这些工具（自主智能体的白名单，已与用户权限求过交集）。
  // 空串/空数组 = 不额外收窄。
  //
  // 【为什么必须落库】执行是后台跑的、可以挂起几小时再被叫醒——那时候
  // 起初传进来的那个参数早就不在了。只在建行时用它拼一遍系统提示词是**假的收窄**：
  // 提示词里没列的工具，模型照样能调（tool schema 是每轮现算的）。
  toolAllowlist String @default("[]")
  // 哪条定时派出来的（null = 不是定时派的）。
  //
  // 【为什么必须记】定时的「连败三次自动停用」闸原来靠同步返回值记账
  //（await runWorkflow 拿到 view.status 当场写）。而派一条 AI 执行是**异步**的：
  // 派发那一刻它还没跑，拿不到结局。不记这一列的话，failStreak 永远不累加——
  // 一条配坏的定时会每天准点烧配额，而且永不自动停用。
  scheduledAgentId String?
  // 谁派出来的子运行（null = 用户自己派的）。**松引用不加外键**：
  // 父运行被到期清理删掉之后，子运行的记录本身还是有意义的。
  //
  // 【嵌套只许一层】它非空就说明「我已经是子运行了」——那时再派自主智能体一律拒绝。
  // 不拦的话一个配错的智能体可以自己派自己，几层下去就是指数级的额度消耗。
  parentRunId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentSteps AgentStep[]
  notes      AgentRunNote[]
  artifacts  AgentArtifact[]

  @@index([workspaceId, createdAt])
  // 到期清理按 (status, updatedAt) 扫全库（lib/legal/retention.ts）。
  // 只有 workspaceId 那条索引的话，这张只增不减的表一大就是全表扫。
  // 定时兜底（lib/agent/tick.ts）也走它：按 status 捞 waiting_quota 与租约过期的 running。
  @@index([status, updatedAt])
  // 叫醒时按「在等哪件事」反查（一件事可能有多次运行在等）
  @@index([waitingOn])
  // 并发闸数「这个工作区正在跑几个」、提拔时找「排队最久的那个」，都走它
  @@index([workspaceId, status])
}

// 一键任务：预先设定好的「目标 + 让谁干 + 授权到什么程度」。
//
// 【为什么需要它】派活现在要打一段字、选一个智能体、勾一次授权范围——
// 而绝大多数人反复要的就是那么三五件事（「看看昨天数据给建议」「按人设出 6 条选题」）。
// 每次重打一遍不只是麻烦：**授权范围每次都要重勾，勾错了没人拦得住**。
// 存成一张卡，点一下就派，授权也是上次定好的那份。
//
// 它同时是定时的载体：ScheduledAgent 现在可以指向一条预设任务而不只是流水线模板。
model TaskPreset {
  id          String   @id @default(cuid())
  tenantId    String
  workspaceId String
  title       String
  // 派出去的那句话
  goal        String
  // 让哪个智能体干（null = 通用助手）。松引用不加外键：模板被删了这张卡还在，
  // 派的时候会如实说「那个智能体已经不在了」
  agentTemplateId String?
  // 授权档。**无人值守只有挂了定时的才允许**——页面上点一下的时候人就在跟前，
  // 没有理由不问他（判定在 lib/agent/run.ts 的 resolveAuth）
  authMode    String   @default("confirm_each")
  // JSON string[]：预授权勾定的工具
  preauthorizedTools String @default("[]")
  enabled     Boolean  @default(true)
  sort        Int      @default(0)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled, sort])
}

// 这次执行到底做出了什么东西。
//
// 【为什么需要它】此前「AI 改了我哪些东西」只能从步骤流水的文本里读——
// 那是给人扫一眼用的截断文本，点不动、也回不去。产物散落在草稿版本、发布计划、
// 图片资产各自的表里，用户要自己一个个页面去找。
//
// 确认闸管的是**动作发生之前**（这一步要不要做），产物清单管的是**之后**
//（做出来的东西对不对）。两道闸互补，不能互相替代：预授权跑完的那些没有前一道，
// 更需要后一道。
model AgentArtifact {
  id     String @id @default(cuid())
  runId  String
  // draft | draft_version | topic | image | publish_plan | schedule | browser_task
  kind   String
  // 指向业务表那一行。**松引用不加外键**：产物表各式各样，
  // 而且产物被用户删掉之后这条记录仍有价值（「它当时做了这个，现在没了」）
  refId  String
  // 给人看的一句话：「新建草稿《秋季开学季》」
  label  String
  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

// 跑着跑着用户又说了一句话（追问、补充要求、确认时的附言）。
//
// 【为什么是一张表而不是 AgentRun 上的一个 JSON 列】
// 这一列会有**两个写入方**：web 请求（用户打字）与后台循环（消费掉它）。
// 而 JSON 列只能读-改-写，两边同时来必丢话——用户那句话消失得无声无息。
// insert-only 的子表天然没有这个问题：追加是纯 INSERT，消费是按 id 标记。
// 顺带还得到一件事：附言也进了审计流水，「AI 为什么这么做」能追到是谁在中途说了什么。
model AgentRunNote {
  id     String @id @default(cuid())
  runId  String
  text   String
  // 什么时候被送进模型的对话里。空 = 还没送达（界面上要标出来，
  // 否则用户以为说了就生效了，而它可能要等到下一轮才被读到）
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  // 排干时按「这次运行还没消费的」查，一次一批
  @@index([runId, consumedAt])
}

// 每一步留痕：调了什么工具、参数是什么、结果是什么、用户是不是拒绝了。
// 这张表是「AI 到底动了我哪些东西」唯一能回答清楚的地方，不许省。
model AgentStep {
  id        String   @id @default(cuid())
  runId     String
  seq       Int
  kind      String // tool_call | tool_result | answer | rejected | error
  tool      String   @default("")
  args      String   @default("{}")
  result    String   @default("")
  ok        Boolean  @default(true)
  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, seq])
}


// ─────────────────────── 域17：多平台一键发布 ───────────────────────
//
// 【为什么是「计划 + 任务」而不是一个 publish 字段】各平台的发布口径差得太远：
// 公众号有官方接口（服务端能直发到草稿箱），抖音/小红书/B站没有对个人开放的发布接口
//（只能由插件在你自己的创作后台把内容填好、**停在发布按钮前**由你点），
// X/YouTube 要么要付费 API 要么要视频文件。把它们塞进一个状态字段，
// 结果一定是「显示已发布，其实只是填好了」这种最糟糕的错报。
model PublishPlan {
  id            String   @id @default(cuid())
  workspaceId   String
  accountId     String
  draftId       String
  status        String   @default("open") // open | done | cancelled
  // AIGC 声明确认（与登记发布同一道闸）：没确认不许进入任何真实发布动作
  aigcConfirmed Boolean  @default(false)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     PublishTask[]

  @@index([workspaceId, createdAt])
  @@index([draftId])
}

model PublishTask {
  id             String  @id @default(cuid())
  planId         String
  platform       String
  // api=服务端调官方接口 | extension=插件在创作后台填好由用户点发布 | manual=只能人工，平台没有可用通道
  channel        String
  // pending=待处理 | ready=内容已备好（等插件/人工）| filled=插件已填好待用户点发布
  // | submitted=已提交平台（公众号草稿箱）| published=确认已发布 | failed | skipped
  status         String  @default("pending")
  title          String
  content        String
  // {tags:[], topics:[], firstComment:'', mentions:[], submitToPublish:false}
  extra          String  @default("{}")
  coverAssetId   String?
  error          String?
  publishedUrl   String?
  platformItemId String?
  // 平台侧返回的凭据（如公众号草稿 media_id），供后续跳转/提交用
  externalRef    String?
  filledAt       DateTime?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  plan PublishPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([status, updatedAt])
  // 谁领走了这条活（IngestToken.id 或 'legacy'），以及领到什么时候。
  //
  // 【为什么要加】这个队列曾经是**无锁广播**：任何持令牌的执行体 GET 一次就看到全部待办。
  // 用户既装了浏览器插件、又在 Mac mini 上跑着本机执行体时，同一篇稿子会被**各填一遍**——
  // 而如果他还开了「代点发布」，那就是发两次。
  //
  // 租约比 BrowserTask 那边长得多（30 分钟 vs 15 分钟）：这一步是**人在环里**的，
  // 用户要看一眼填得对不对再点发布，按机器的节奏计时会把他正在看的那条抢走。
  claimedBy   String?
  leaseUntil  DateTime?
}

// 平台官方接口凭证（目前只有微信公众号用得上）。appSecret 与模型 Key 同一套加密。
model PublishCredential {
  id           String   @id @default(cuid())
  accountId    String
  platform     String // wechat
  appId        String
  appSecretEnc String
  status       String   @default("untested") // untested | ok | failed
  lastError    String?
  // ── 微博 OAuth（2026-08-19）：微博的发布接口走 access_token，不像公众号那样能用 AppSecret 现换 ──
  // token 与 appSecret 一样是密文（encryptKey），过期时刻单独存一列，好在界面上如实显示「还有多久要重授权」。
  tokenEnc       String?
  tokenExpiresAt DateTime?
  // 平台侧的用户 id（微博 uid）。授权换到的是哪个号，界面上要能核对，避免授权错账号。
  externalUid    String?
  // 平台强制要求正文里带一条本域链接时用（微博 statuses/share 的硬规则），存用户自己填的回链
  linkUrl        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account CreatorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, platform])
}


// ─────────────────────── 域18：工作流模板与模板市场 ───────────────────────
//
// 模板 = 一条可复用的流水线：选题 → 初稿 → 技能改写 → 封面 → 配图 → 发布计划。
// 与「技能」（ContentSkill = 一个提示词模板）的分工：技能是**一步**，模板是**一串**。
// 存储沿用技能那一套（内置全局 + 租户自建 + 按租户安装），不另发明一套市场机制。
model WorkflowTemplate {
  id          String   @id @default(cuid())
  // null = 内置模板（全租户可见）；有值 = 某个租户自建的
  tenantId    String?
  slug        String   @unique
  name        String
  description String   @default("")
  emoji       String   @default("🧩")
  category    String   @default("general")
  // 职责说明：这个智能体是谁、什么时候该派它上。**给人看也给模型看**——
  // AI 助手靠它决定「用户这句话该派哪一个」，所以写「适合什么场景」比写「它很厉害」有用。
  // 空 = 只能手动点运行，AI 不会主动派它（见 lib/workflow/agent-pick.ts）。
  persona     String   @default("")
  // 跑之前得先有什么（人话）。空 = 装上就能直接跑。
  //
  // 【为什么要有它】「小红书日更三件套」第一步是从最高分选题写初稿，而新账号一条选题都没有
  // ——用户装上、点「跑一遍」，第一步就撞「没有可用选题」。三条内置模板里有两条是这样。
  // 那句失败信息虽然指了路，但用户是在**花了一次点击之后**才知道的。
  requires    String   @default("")
  // JSON: WorkflowStep[]，形状与解析口径见 lib/workflow/steps.ts。**只有流水线形态用它**
  steps       String   @default("[]")
  // 这个智能体是哪一种：
  //   pipeline（缺省）—— 一串定死的步骤，跑法完全可预期，模板作者定死一切
  //   autonomous     —— 给它目标和授权范围，它自己安排怎么做
  //
  // 【为什么保留流水线而不是全改成自主】确定性的日更流水线自有价值：
  // 用户要的就是「每天照这三步来」，不需要它临场发挥。而且「模板不做自由脚本步」
  // 是防可分享模板携带任意执行的红线——两种形态都是**纯数据**，只是数据的形状不同。
  mode        String   @default("pipeline")
  // JSON，**只有 autonomous 形态用它**：
  //   { systemPrompt?: string, tools: string[], callBudget?: number, defaultAuthMode?: string }
  //
  // tools 是这个智能体能用的工具白名单。**它只能收窄不能放宽**——
  // 派它的时候会与「当前用户自己有权用的工具」求交集，装了别人分享的智能体
  // 不可能因此突破自己的权限或工作区开关。
  agentConfig String?
  isBuiltin   Boolean  @default(false)
  enabled     Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 与 ContentSkill 同构：内置模板 tenantId=null（全局行），自建的挂租户。
  // ⚠️ 这条外键此前**漏了**：注销租户时靠 Cascade 删数据，没有它自建模板会留成
  // 永远没人清的孤儿行（而 ContentSkill 一直有）。
  tenant    Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installs  WorkflowInstall[]
  runs      WorkflowRun[]
  schedules ScheduledAgent[]
}

model WorkflowInstall {
  id          String   @id @default(cuid())
  tenantId    String
  templateId  String
  enabled     Boolean  @default(true)
  installedAt DateTime @default(now())

  // 同上：SkillInstall 有这条，WorkflowInstall 漏了
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([tenantId, templateId])
}

// 一次跑模板的过程。中途失败要能看出**停在哪一步、为什么**——
// 只记一个 failed 的话，用户唯一能做的就是整条重跑（前面几步的钱白花了）。
model ScheduledAgent {
  id          String   @id @default(cuid())
  workspaceId String
  // 到点了派什么：workflow=一条流水线模板（旧行为）| task=一条预设任务（可以是自主智能体）
  targetKind  String   @default("workflow")
  // targetKind='task' 时指向哪条预设任务。松引用不加外键：卡被删了这条定时会如实报错停用
  taskPresetId String?
  // 派它在哪个创作账号名下干活。账号删了这条也没意义了，跟着走
  accountId   String
  // 可空：targetKind='task' 时指的是 taskPresetId，没有模板
  templateId  String?
  // 北京时间的时刻（lib/beijing.ts 口径）。**不给用户写 cron**——
  // 会写 cron 的人是少数，而写错一个字段就是每分钟跑一次 AI，账单当天就爆
  atHour      Int      @default(9)
  atMinute    Int      @default(0)
  // 周几跑：JSON 数字数组（0=周日）。空数组 = 每天
  weekdays    String   @default("[]")
  enabled     Boolean  @default(true)
  // 连续失败次数。达到 AUTO_PAUSE_FAILS 自动停用并告警——
  // 没有这一条的话，一个坏模板会每天准点烧一次配额直到用户自己发现
  failStreak  Int      @default(0)
  // 上一次实际跑的**逻辑日**（北京时间 YYYY-MM-DD）。用它防重跑：
  // 扫描是每 10 分钟一次，只比时刻的话一个窗口内会连开好几次
  lastRunDay  String?
  lastRunAt   DateTime?
  lastStatus  String?
  lastError   String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // 关系跟着 templateId 一起变可空（targetKind='task' 时没有模板）
  template  WorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([enabled, atHour])
  @@index([workspaceId])
}

model BrowserTask {
  id          String   @id @default(cuid())
  workspaceId String
  // 派给哪个创作账号做（collect_self 要用它决定进谁的后台）
  accountId   String?
  // 白名单动作，见 lib/browser-task/kinds.ts。**不许放任意指令进来**
  kind        String
  // JSON 参数（如 {competitorId} / {platform}）。形状由 kind 决定，服务端 zod 校验后才落库
  payload     String   @default("{}")
  // pending=等插件来领 | claimed=已被某个浏览器领走 | done | failed | expired | cancelled
  status      String   @default("pending")
  // 谁派的：agent=AI 执行器 | user=用户在页面上点 | schedule=定时智能体 | api=对外调用面(/api/v1)
  origin      String   @default("agent")
  // 领走它的那个浏览器（IngestToken.id）。用于「同一台机器别重复领」与排查
  claimedBy   String?
  claimedAt   DateTime?
  // 领了多久没交活就放回池子（插件可能被关掉/崩了）
  leaseUntil  DateTime?
  // 过期就别做了：三天前让采的数据，现在采回来也没意义
  expiresAt   DateTime
  attempts    Int      @default(0)
  // 给人看的一句话回执（截 500 字）
  result      String?
  // 插件带回来的**内容本体**（open_and_read 的页面文本等），JSON 字符串。
  // 与 result 分开：前者是「跑成没有」给人看，这里是「拿到了什么」给服务端接着处理。
  // 上限见 lib/browser-task/kinds.ts 的 MAX_READ_TEXT_CHARS——超了截断不打回，
  // 且必须留在 WAF 的请求体阈值以内（超限会回一个假的 HTTP 200）
  resultData  String?
  error       String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // 插件领活的主路径：按 workspace 找 pending 且没过期的
  @@index([workspaceId, status, expiresAt])
  @@index([status, leaseUntil])
}

model WorkflowRun {
  id          String   @id @default(cuid())
  workspaceId String
  accountId   String
  templateId  String
  draftId     String?
  status      String   @default("running") // running | done | failed | cancelled
  // 谁把它跑起来的：manual=用户在页面上点的 | schedule=定时计划 | agent=AI 助手在对话里派的。
  // 缺省 manual：这个字段是后加的，存量行全是当时唯一的那条路径（页面手点）。
  trigger     String   @default("manual")
  stepIndex   Int      @default(0)
  // JSON: 每步的 {kind, ok, message, at}
  log         String   @default("[]")
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // 关系跟着 templateId 一起变可空（targetKind='task' 时没有模板）
  template  WorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  // 同 AgentRun：到期清理走 (status, updatedAt)
  @@index([status, updatedAt])
}


// ─────────────────────── 域19：采集自学习（解析规则自愈）───────────────────────
//
// 【要解决什么】平台改版 → 插件的选择器失效 → 采不到数据。此前的能力只到「看得见」
//（lib/ingest/parser-health.ts 的降级告警），修还是要人去改代码、发新版插件、等用户更新。
// 这两张表把后半程补上：疑似改版留证 → 让模型从**脱敏后的页面结构**里推断新锚点 →
// 影子验证 → 人工审核 → 规则包下发（插件当天就能用上，不必发版）。
//
// 【隐私红线】ParserIncident.skeleton 存的是**结构骨架**：标签名、类名、data-* 属性名、
// 文本的形状（如「12.3万」→「NUM万」），**不含任何正文、昵称、链接、图片**。
// 服务端收到后还会再脱敏一次（lib/ingest/parser-learn.ts sanitizeSkeleton）——
// 不信任客户端上传的东西是这条链路的底线。
model ParserIncident {
  id          String   @id @default(cuid())
  workspaceId String
  platform    String
  // rival | self
  scope       String
  // 哪个字段没采到（followers | views | likes | items | title …）
  field       String
  // open=待处理 | proposed=已产出候选规则 | resolved=已修好 | ignored
  status      String   @default("open")
  // 脱敏后的页面结构骨架（JSON 字符串，有大小上限）
  skeleton    String   @default("")
  // 失败现场截图（0.9.9 起，data:image JPEG；只在用户正看着的页面失败时才有）。
  // 大小由 vetScreenshot 闸住（150K 字符，WAF 请求体阈值之下）；30 天由保留期任务清空。
  screenshot  String   @default("")
  note        String   @default("")
  samples     Int      @default(1) // 同一指纹撞了几次
  fingerprint String // platform+scope+field，用于合并同类事件
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rules     ParserRule[]

  @@index([platform, status])
  @@index([workspaceId, createdAt])
}

// 可下发的解析规则（版本化）。插件按 platform 拉「当前生效」的那一版。
//
// ⚠️ candidate → active 必须经人审：模型推断出来的选择器可能指向**旁边那个数字**
//（抖音「关注 178 / 粉丝 328.3万」那次事故的形状）。自动上线等于把一个看着正常、
// 实际差三个数量级的数字直接写进所有人的库。
model ParserRule {
  id         String   @id @default(cuid())
  platform   String
  field      String
  // CSS 选择器候选，按优先级排列（JSON string[]）
  selectors  String   @default("[]")
  // 文本锚点兜底（JSON string[]，如「粉丝」「获赞」）
  anchors    String   @default("[]")
  // candidate=模型产出待审 | active=已下发 | retired=被新版本取代或回滚
  status     String   @default("candidate")
  version    Int      @default(1)
  // 影子验证的命中率（0-1）。null = 还没验证过——**不许当成 0 或 1**
  hitRate    Float?
  source     String   @default("llm") // llm | manual
  note       String   @default("")
  incidentId String?
  reviewedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  incident ParserIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([platform, status])
  @@unique([platform, field, version])
}

// ── 对外调用令牌（批 5B）────────────────────────────────────────────────────
//
// 【为什么不复用采集令牌】那一枚的语义是「往这个工作区回传采集数据 / 领发布任务」，
// 它**不绑成员**（工作区级），也就没法回答「这次调用按谁的权限算」。
// 而 AI 执行的每一步权限都是按发起人算的（lib/agent/run.ts 的 contextForRun），
// 拿一枚不知道是谁的令牌去开执行，等于凭空造出一个没有主人的操作者。
//
// 【所以这一枚必须绑到人】token → Member，执行时用这个人的角色跑 RBAC。
// 他被降权或移出团队，这枚令牌立刻跟着失效——不需要额外做什么。
model ApiToken {
  id        String    @id @default(cuid())
  // 令牌明文（bck_ 前缀，与采集令牌的 bcn_ 一眼可分）。唯一约束 = 鉴权一次 findUnique 命中
  token     String    @unique
  // 这枚令牌代表谁在调用。**权限按他算**
  memberId  String
  // 用户自己起的名字，如「我的 Mac mini」「Claude Desktop」。收回时靠它认出是哪一个
  label     String
  createdAt DateTime  @default(now())
  // 节流写入（同采集令牌）：每次调用都更新等于给每个请求平白加一次写库
  lastUsedAt DateTime?
  // 非空 = 已吊销。不删行——用户要看得到「这枚是什么时候收回的」
  revokedAt DateTime?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, revokedAt])
}
