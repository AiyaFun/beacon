# 烽火台生产环境变量模板 —— 复制为 .env.production 并填写。
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# 图例：【必填】不填服务起不来或功能不可用 ／【可选】不填优雅回退（见每条说明）
#
# ⚠️ .env.production 含明文密钥，别提交进 git（确认 .gitignore 里有它）、别放进镜像。
# ⚠️ 一个例外：REDIS_PASSWORD 不在本文件里读 —— 见下面第 0 节（它要拼进 compose 的 ${...} 插值）。
# ⚠️ 用 docker compose 起时，REDIS_URL / BEACON_QUEUE 会被 compose 的 environment: 覆盖；
#    但 DATABASE_URL **不再被覆盖**（改用火山引擎 Supabase 版后 compose 不注入它）——
#    **本文件里第 1 节那一行就是最终值**，compose 与非 compose 部署都读它。

# ── 0. compose 用的 Redis 密码（不走本文件）──────────────────────────
# 【必填】docker compose 的 ${VAR} 插值只从 shell 环境或项目根目录的 .env 里取，
# 读不到本文件。没设会直接报错退出（不会偷偷用弱默认值）。起服务前先 export：
#
#   export REDIS_PASSWORD="$(openssl rand -hex 32)"
#
# 用 -hex（纯字母数字）是有意的：它会被拼进 REDIS_URL 连接串，含 @ : / # ? 等字符要 URL 编码。
#
# ⚠️ 数据库密码不在这里 export：改用火山引擎 Supabase 版后，本地不再有 postgres 容器，
#    数据库密码是火山控制台给的，直接写进下面第 1 节的 DATABASE_URL（随本文件其它密钥一起，chmod 600）。
#    原来的 POSTGRES_PASSWORD 已废弃，不用再 export。

# ── 1. 数据库（火山引擎 Supabase 版托管 Postgres + pgvector）──────────
# 【必填】compose 不再覆盖它，**这一行就是生产连接串**。从火山控制台复制：
#   目标 Workspace → 分支管理 → 分支总览 → Supabase 服务 → 「连接串」卡片 → 选 PostgreSQL。
#   （main 分支「初始化中」时卡片没值，等初始化完成再取。走公网串则先在控制台开「公网访问」。）
#
# 控制台复制到的串形如：postgresql://postgres:<密码>@<host>:<port>/postgres?sslmode=require
#   · 建议创建专用角色 beacon_app（而非直接用 postgres），见 docs/火山Supabase迁移.md。
#   · 表存放在独立的 beacon schema（不用 public，避开 cloud_admin 权限限制），
#     连接串须带 schema=beacon 让 Prisma 正确寻址。
#   · 密码含 @ : / # ? 等特殊字符要 URL 编码（@→%40 等）。
#   · 核对端口：火山这版是**标准直连**（预期 5432），host 里**不该有 pooler 字样**——
#     若真有 pooler，回去找连接调研重估（可能要加 ?pgbouncer=true；本版默认**不需要**）。
#
# 在控制台串基础上**追加这几个参数**（连接数收敛 + 冷启动容错，理由见 docs/火山Supabase迁移.md）：
#   ?sslmode=require&connection_limit=3&pool_timeout=20&connect_timeout=15
#   （控制台串已带 sslmode=require 就用 & 接后三个；没带 sslmode 手工补上，加了永远安全。）
#   connection_limit=3：火山每分支活跃连接 ≤10，web+worker 两进程各 3 = 6，留 4 给控制台/迁移/PITR。
#
# ⚠️ 首次要手工初始化（建表 + pgvector + RLS）：scripts/db-init-supabase.sh，见 docs/火山Supabase迁移.md。
# ⚠️ 安全红线：火山默认把 public schema 经 Data API(anon_key) 对外暴露，本项目不用 Data API，
#    **务必去控制台关掉/收窄**，否则未开 RLS 的 LlmCallLog / WxPayNotifyLog 等表会被匿名读走。见 docs。
DATABASE_URL="postgresql://beacon_app:CHANGE_ME@<火山host>:5432/postgres?schema=beacon&sslmode=require&connection_limit=3&pool_timeout=20&connect_timeout=15"

# ── 2. 任务编排 ──────────────────────────────────────────────────
# 【必填】"bullmq" = 用 Redis 队列（生产）；留空/其他值 = 进程内队列（worker 容器就白跑了，
# 定时任务不会执行）。生产必须 bullmq。
BEACON_QUEUE="bullmq"

# 【必填】compose 会注入（含密码）。独立部署时格式：redis://:密码@主机:6379
# 不填则回退 redis://127.0.0.1:6379，容器里连不上会一直重试。
REDIS_URL="redis://:CHANGE_ME@redis:6379"

# 【可选】worker 并发数，默认 4。CPU 少或 LLM 限流严就调小。
BEACON_WORKER_CONCURRENCY="4"

# ── 3. 主密钥（BYOK 信封加密）────────────────────────────────────
# 【必填】用来加密租户存的第三方 API key。生成：
#
#   openssl rand -base64 48
#
# ⚠️ 生产不配会直接启动失败（fail-fast，防止误用 dev 默认弱密钥）。
# ⚠️ 丢了它 = 所有租户已存的 BYOK key 全部解不开，只能让用户重填。做好备份 / 用 KMS 注入。
# ⚠️ 轮换需先用旧密钥解密再用新密钥重加密，不能直接改。
BEACON_MASTER_KEY=""

# ── 4. LLM（平台默认模型）───────────────────────────────────────
# 【必填】不填则平台默认模型不可用，租户只能自带 key（BYOK）。
# 国内合规建议用已备案模型。key 去对应厂商控制台拿。
BEACON_DEFAULT_LLM_BASE_URL="https://api.deepseek.com"
BEACON_DEFAULT_LLM_API_KEY=""
BEACON_DEFAULT_LLM_MODEL="deepseek-chat"

# ── 5. 向量嵌入（语义记忆 / 话题聚类）──────────────────────────────
# 【可选】不填则语义检索与聚类降级为关键词匹配，效果变差但不报错。
# 可自部署 BGE-M3，或用云厂商 embedding 接口。
BEACON_EMBED_BASE_URL=""
BEACON_EMBED_API_KEY=""
BEACON_EMBED_MODEL="bge-m3"

# ── 6. 数据源 ────────────────────────────────────────────────────
# 【可选】自部署开源热榜实例（DailyHotApi）。不填则该数据源跳过。
BEACON_DAILYHOT_BASE_URL="http://dailyhot:6688"

# 【可选】60s 开源接口，默认用公开实例 https://60s.viki.moe/v2 。
# 自部署后在这里覆盖；设 BEACON_60S_DISABLED="1" 可整个关掉这个源。
BEACON_60S_BASE_URL=""
BEACON_60S_DISABLED=""

# 【可选】BEACON_HOT60S：60s 通道总开关。**生产态默认开**（未配 DailyHot 时免 key 兜真实数据）；
# 设 "0" = 显式关闭，热榜全部走内置示例数据。
# （注意 dev 态相反：默认离线走 Mock，要显式设 =1 才联网——见 .env.example。本文件是生产模板。）
# ⚠️ 60s 公开实例是个人维护的免费服务、无 SLA，随时可能限流或下线。
# 单个源不可达时仅该源回退示例数据（页面标「示例数据」），其余源与整体抓取不受影响，
# 也不会把 /api/health 打成 unhealthy（它是数据源，不是基础设施）。
# 生产建议：自部署 DailyHotApi（见上方 BEACON_DAILYHOT_BASE_URL），或自部署 60s 填 BEACON_60S_BASE_URL。
BEACON_HOT60S=""

# 【可选】竞对采集。每个源不填 → 对应平台跳过，不影响其他平台。
BEACON_TIKHUB_KEY=""                 # TikHub，抖音/小红书等，tikhub.io 控制台
BEACON_NEWRANK_KEY=""                # 新榜开放平台
BEACON_YOUTUBE_API_KEY=""            # Google Cloud Console → YouTube Data API v3
BEACON_TWITTERAPI_KEY=""             # twitterapi.io
BEACON_BILIBILI_ENABLED=""           # ="1" 启用 B 站采集（走公开接口，无需 key）
BEACON_RSSHUB_BASE_URL=""            # 自部署 RSSHub 实例（开源自建通道）：竞对"发新内容"监控的
                                     # 备源（有商业源的平台）/主源（抖音/小红书未配 TikHub 时）。
                                     # 只在自部署实例上用；无指标数据，指标靠商业源或插件回传补。

# ── 7. Agent Skills 导出 ────────────────────────────────────────
# 【可选】不填则 Skills 导出功能不可用，其余功能正常。
# 去 console.anthropic.com 拿。
BEACON_ANTHROPIC_API_KEY=""

# ── 7.5 公开访问地址 + 采集助手商店链接 ─────────────────────────────
# 【建议填】BEACON_PUBLIC_URL：机器人推送卡片里的跳转链接、拼回调地址的兜底基址。
BEACON_PUBLIC_URL="https://your-domain.example.com"
# 【可选】采集助手上架 Chrome 应用商店后填详情页链接（见 extension/store/PUBLISH.md）。
# 只提交 Chrome 一家；Edge/360/Brave 不单独上架，永远走 zip 开发者模式加载。
# 空=未上架，/extension 页 Chrome 卡片显示「商店审核中」并回落到自托管 zip。
BEACON_EXT_STORE_CHROME=""

# ── 8. 短信（火山引擎）──────────────────────────────────────────
# 【必填】唯一合法值："volcengine"。**不要留空** —— 这里的默认值是有意填好的。
#
# ⚠️ 生产留空 = 账号接管漏洞，不是「功能不可用」：
#    Mock 通道会把验证码**明文回显给调用方**，任何人在登录页输入任意手机号即可登进
#    该账号。所以生产态未配 vendor 不是「优雅回退 Mock」，而是**拒绝服务**。
#
# ⚠️ 生产留空的后果是 fail-fast：**第一次发验证码时**抛错（不是启动时就炸）。
#    校验刻意做成懒校验 —— 顶层 throw 会把 next build 打挂（构建期恒为
#    NODE_ENV=production 且无 env）。所以「容器起来了」不代表短信配对了，
#    必须真发一条码验证（见 docs/生产化部署.md「短信」）。
#    这是有意设计，不是让你把它改回空值绕过去。
#
# ⚠️ 填了 volcengine 但 AK/SK/SIGN 没填全 → 同样抛错，不会静默回退 Mock。
#
# （留空只在 dev 态合法：BEACON_ENV=dev 且非 NODE_ENV=production 时走 Mock，
#   验证码打到控制台，用于零配置本地联调。本文件是生产模板，不适用。）
BEACON_SMS_VENDOR="volcengine"

# 【必填(若启用短信)】AK/SK 去火山引擎控制台 → 访问控制 → 密钥管理 拿。
# ⚠️ 服务器公网 IP 必须加进短信服务的 IP 白名单，否则报 RE:0007。
BEACON_VOLC_SMS_AK=""
BEACON_VOLC_SMS_SK=""

# 【必填(若启用短信)】短信签名内容（填签名文本本身，不是 ID），须在控制台已过审。
# 签名不属于该消息组会报 RE:0004。
BEACON_VOLC_SMS_SIGN=""

# 【可选】消息组 ID（控制台 → 短信服务 → 消息组），默认 1b6d4896。
# ⚠️ 填 ID 不是名称，填错报 RE:0003。
BEACON_VOLC_SMS_ACCOUNT="1b6d4896"

# 【可选】短信模板 ID，须已过审且属于上面的消息组，否则报 RE:0005。
BEACON_VOLC_SMS_TEMPLATE="S1T_1y2pb4u4rerr6"

# 【可选】模板里的变量名，默认 code。
# ⚠️ 必须和控制台模板定义完全一致：模板写的是 ${code} 就填 code，写 ${verifyCode} 就填 verifyCode。
# 对不上会发送失败或收到空验证码。
BEACON_VOLC_SMS_PARAM_NAME="code"

# 【可选】火山短信服务区域，默认 cn-north-1。一般不用改。
BEACON_VOLC_SMS_REGION="cn-north-1"

# ── 9. 配额 ─────────────────────────────────────────────────────
# 【可选】只控制**按租户的 LLM 调用配额**（lib/quota.ts，按 Tenant.plan 分日/月档）。
#
# ⚠️ 它**不控制限流**。登录发码/校验的 IP 限流（app/login/actions.ts）**无条件生效**，
#    没有开关也关不掉。别指望改这里能放开限流。
#
# ⚠️ 取值语义（实测，别照直觉理解）：
#      "1" / "true"   → 开
#      "0" / "false"  → 关
#      其他任何值（含 "yes"、"on"、空串）→ **按未设置处理**，落到下面的默认
#      未设置 / 注释掉本行 → **生产默认开、开发默认关**（本文件是生产模板 = 开）
#
#    也就是说：注释掉这一行**不会关闭配额**，生产下它照样是开的。
#    真要关，必须显式写 BEACON_QUOTA_ENABLED="0"。
#    （踩过的坑：照「不填=不限」把这行注释掉 → 配额照样拦人 → 排查半天。）
#
# 分档阈值（free 30次/天、personal 200、team 1000、enterprise 5000）写死在
# lib/quota.ts 的 PLATFORM_TIERS，目前没有 env 可调。
# ⚠️ 另见 VERIFICATION.md：当前**没有任何路径能修改 Tenant.plan**（无支付、无后台），
#    新注册租户恒为 free。开着配额 = 所有真实用户被锁在 30 次/天。
BEACON_QUOTA_ENABLED="1"

# ── 9.5 可信反代层数（IP 限流的前提）────────────────────────────
# 【必填】= 你入口处**会写 x-forwarded-for 的可信反代层数**。
#   本仓库 docker-compose.yml 的默认拓扑（Nginx → web）→ "1"，已是下面的默认值。
#   自己在前面又加了 CDN/CLB → "2"。前面**什么反代都没有** → 必须留 "0"。
#
# ✅ 默认 "1" 的前提：本仓库的 docker-compose.yml **自带一层 Nginx 反代**
#    （services.proxy，配置在 deploy/nginx.conf），它用
#      proxy_set_header X-Forwarded-For $remote_addr;   ← 覆写语义
#    整段丢弃客户端自带的 XFF，只写它亲眼看到的对端 → XFF 恒为 1 个值 → 恰好对应 hops=1。
#    照本仓库的 compose 跑，这个值**不用改**。
#
# ⚠️ 但凡你偏离这个拓扑，就必须重新数：
#    - 不用本仓库的 compose、自己裸跑 web（前面没有任何反代）→ **必须改回 "0"**。
#      裸跑时 XFF 完全由客户端说了算，填 1 = 把伪造绕过原样装回去
#      （实测直连 web：`XFF: 9.9.9.9` → getClientIp() 读出 9.9.9.9，换一个新配额桶）。
#    - 前面加了 CDN/CLB → 改 "2"，**同时**要把 deploy/nginx.conf 那行改成
#      $proxy_add_x_forwarded_for（追加），否则 Nginx 会把 CDN 写的客户端 IP 覆盖掉。
#
# ⚠️ 两个方向的错法代价不对称：
#      填大了 → 可能**静默地被穿**（攻击者塞 XFF: 9.9.9.9 就换一个新配额桶，
#        刷爆按条计费的短信 —— 无界、账单不可回滚）。这正是当初修掉的那个 BLOCKER。
#      填小了 / 留 0 → **响亮地坏掉**（见下，有界且有告警）。
#    所以不确定时宁可留 0。**但 0 不是可以将就的值 —— 它只是安全的错。**
#
# ⚠️ 留 0 的实际后果：生产态 getClientIp() 一律返回 unknown = **全站共用一个限流桶**。
#    每小时全站只有 10 个人能发验证码；login:verify 全站共用 20 次/10 分钟
#    → 单个攻击者约 30 个请求就能让整站登录瘫痪。是 fail-close 型 DoS，不是轻微退化。
#
# ⚠️ 为什么代码不能自己猜：Next 只在 XFF **缺失**时才注入对端地址（`??=`），
#    客户端自己带了就原样透传，且 App Router 不把 socket 暴露给 Server Action。
#    → 应用层无法区分「反代写的 XFF」和「伪造的 XFF」，也拿不到直连 IP。只能靠本变量声明。
#
# ⚠️ 必须**精确等于**实际层数（代码取 XFF 右起第 N 跳）。实测：
#    实际 1 层却填 2 + XFF="9.9.9.9, <真实IP>" → 读出攻击者可控的 9.9.9.9。
#    只有 XFF 比声明层数还短时才会 warn + 判 unknown——攻击者不会帮你触发这个保护。
#
# ⚠️ 前提：入口必须真的有反代在写 XFF。覆写（$remote_addr）和追加
#    （$proxy_add_x_forwarded_for）**两种语义本项目都支持**，单层都配 "1"。
#    云厂商 CLB/SLB/ALB/Cloudflare 一律追加语义，每层各占一跳。
#    完整 Nginx 片段与数 hops 的方法见 docs/生产化部署.md「反代必须覆写 XFF」。
#
# ⚠️ 反代必须是**唯一**入口，否则它挡不住任何东西：攻击者只要能直连 web 的 3000，
#    就能自己伪造 XFF 绕开整层防护。docker-compose.yml 里 web 默认只绑 127.0.0.1
#    （BEACON_WEB_BIND），**别改成 0.0.0.0**。云上还要靠安全组只放行 80/443/22。
#
# ⚠️ 自查（两条都要看）：
#    1. 留 0 时进程首次限流会打一条 error 日志（整个进程只打一次，Sentry 可见）：
#         「未配置 BEACON_TRUSTED_PROXY_HOPS：…IP 限流已退化为全局闸门」
#       上线后搜不到这条 = 这行已生效；搜得到 = 你其实还在 0。
#    2. hops 填得比实际层数大时会打 warn：「x-forwarded-for 跳数少于 …」。
#       搜到这条 = 你的 hops 配大了（或反代没在写 XFF），**赶紧查**。
#    实测验证命令见 docs/生产化部署.md「一条命令自查反代配对了没」。
BEACON_TRUSTED_PROXY_HOPS="1"

# ── 9.6 web 的宿主机端口绑定（反代的前提）────────────────────────
# 【说明】docker-compose.yml 里 web 的端口映射写的是
#     '${BEACON_WEB_BIND:-127.0.0.1}:3000:3000'
#   默认 127.0.0.1 = 只有宿主机自己能连 3000，公网只能走 proxy 的 80/443。**保持默认即可。**
#
# ⚠️ 注意这个变量**不在本文件生效**：本文件是通过 compose 的 `env_file:` 注入到**容器内**的，
#    而 `${...}` 端口插值只读**项目目录下的 .env** 或 shell 环境变量（和 REDIS_PASSWORD 一样）。
#    实测：把 BEACON_WEB_BIND=0.0.0.0 写进本文件 → 端口仍解析成 host_ip: 127.0.0.1（无效）；
#          写进 .env 或 export → 才会变成 0.0.0.0。
#    所以下面这行**故意注释掉**，免得给人「在这儿改就管用」的错觉。真要改：
#      export BEACON_WEB_BIND=0.0.0.0     # ← 但这等于把反代绕过去，别这么干
# BEACON_WEB_BIND="127.0.0.1"

# ── 10. 可观测性 ────────────────────────────────────────────────
# 【可选】Sentry DSN，不填则不上报异常（不影响运行）。
# 去 sentry.io → 项目 → Settings → Client Keys (DSN) 拿。
BEACON_SENTRY_DSN=""

# 【可选】日志级别：debug / info / warn / error，默认 info。
# 生产别用 debug（会打出请求明细，可能含用户数据）。
BEACON_LOG_LEVEL="info"

# 【可选】/api/health 详情鉴权 token。
# 不填：prod 下探针只回状态、不回组件详情（避免内部状态裸奔）；填了则需带
#   请求头 x-beacon-health-token（或 Authorization: Bearer）才给详情。
# ⚠️ 只认请求头不认 query —— token 落进网关/CDN 日志就等于泄露。
# 生成：openssl rand -hex 32
BEACON_HEALTH_TOKEN=""

# 【可选】版本号与服务名，用于日志/Sentry 归因。不填则 release 为空、服务名默认 web。
# 建议 CI 里注入 git sha：BEACON_RELEASE=$(git rev-parse --short HEAD)
BEACON_RELEASE=""
BEACON_SERVICE=""

# ── 11. 合规 ────────────────────────────────────────────────────
# 【可选】AIGC 内容标识里的生成服务提供者名称，默认「烽火台」。
# 按《人工智能生成合成内容标识办法》应填实际运营主体名称。
# 两个都要填成同一个值：服务端出口（导出 PPTX/DOCX/PDF）读 BEACON_，
# 「复制正文」出口跑在浏览器里，Next 只把 NEXT_PUBLIC_* 注入客户端包 ——
# 只配 BEACON_ 的话复制出口会静默回退成默认「烽火台」，标识里的主体名就是错的。
BEACON_AIGC_PRODUCER="烽火台"
NEXT_PUBLIC_AIGC_PRODUCER="烽火台"

# ── 12. 运行环境标记 ────────────────────────────────────────────
# 【必填】"prod" / "dev"。dev 会放宽校验并在登录页回显验证码 —— 生产务必 prod。
BEACON_ENV="prod"

# ── 13. 微信支付（Native 扫码订阅）──────────────────────────────
# 【必填 · 若要收钱】不配这一节，生产环境点「购买」会**直接报错拒绝**（不会回退模拟通道）。
# 这是有意的：模拟通道有个「模拟支付成功」按钮，在生产可达 = 任何人点一下就升团队版。
# 本地开发不用配任何一项 —— 留空即走模拟通道，能看完整 UI、能跑通全流程。
#
# ⚠️ 上线前必须确认一件事：**你的商户号是不是新号、此前从未对接过平台证书模式**。
#    本实现只做「微信支付公钥」模式，不实现平台证书下载/轮换。官方明确新商户号无需切换。
#    若是存量号且在公钥灰度期，微信会**随机**用公钥或平台证书给回调签名，本实现会间歇性
#    验签失败 → 用户付了钱但套餐不生效。详见 docs/微信支付接入.md「公钥模式」。

# 通道开关。填 wxpay 启用微信支付；留空 = 模拟通道（仅开发态，生产态留空会拒绝下单）。
BEACON_PAY_VENDOR=""

# 【必填】公众号/小程序/App 的 appid，必须与 mchid 有绑定关系。
# 不匹配会报 APPID_MCHID_NOT_MATCH。
BEACON_WXPAY_APPID=""

# 【必填】商户号。商户平台首页可见。
BEACON_WXPAY_MCHID=""

# 【必填】**商户 API 证书**的序列号，40 位大写十六进制。
# ⚠️ 是商户API证书（apiclient_cert.pem），不是平台证书，别混用。
# 取法：openssl x509 -in apiclient_cert.pem -noout -serial
# 也可在 商户平台 → 账户中心 → API安全 → API证书 页面直接抄。
BEACON_WXPAY_SERIAL_NO=""

# 【必填】商户 API 私钥 apiclient_key.pem 的**全文**（含 BEGIN/END 行）。
# 多行值在 .env 里用引号包住并保留 \n，或用 docker secret / 文件挂载再读进来。
# 🔒 这是最敏感的一把 —— 拿到它就能以你的名义调微信支付。不要进 git，不要进日志。
#    权限建议 chmod 400，且与 web 容器同宿主的其它服务隔离。
BEACON_WXPAY_PRIVATE_KEY=""

# 【必填】APIv3 密钥，**32 个字符**。商户平台 → 账户中心 → API安全 → APIv3密钥 设置。
# 回调报文用它做 AES-256-GCM 解密。填错的话回调会全部解密失败（用户付了钱但不发货）。
BEACON_WXPAY_APIV3_KEY=""

# 【必填】**微信支付公钥**的 PEM 全文（含 BEGIN/END 行）。
# 取法：商户平台 → 账户中心 → API安全 → 微信支付公钥 → 申请/下载。
# 回调验签用它。这是防「任何人 POST 一下就免费升档」的唯一防线。
BEACON_WXPAY_PUBLIC_KEY=""

# 【必填】微信支付公钥 ID，形如 PUB_KEY_ID_0000000000000024101100397200000006。
# ⚠️ 若你拿到的是 40 位十六进制串，那是平台证书序列号，**不是**公钥 ID —— 本实现不支持平台证书模式。
BEACON_WXPAY_PUBLIC_KEY_ID=""

# 【必填】支付结果回调地址。硬约束（微信侧强制，配错微信直接不回调，极难排查）：
#   1. 必须 https:// 开头的完整全路径
#   2. **不能带 query 参数**
#   3. 外网可达，不能是 localhost / 内网 IP
# 固定填：https://<你的域名>/api/pay/notify
#
# ⚠️ 两条运维前提，缺一个回调就会静默失效：
#   a) 反代（nginx/Cloudflare）必须**透传 Wechatpay-* 请求头**。官方明确有些 CDN 会过滤扩展头，
#      过滤掉 = 应用层拿不到签名 = 全部回调验签失败。nginx 默认会丢带下划线的头，但
#      Wechatpay-Signature 这类是连字符，一般不受影响；Cloudflare 等托管 WAF 需自行确认。
#   b) 这条路由必须在鉴权白名单里（微信要求 notify_url 不得做登录态校验）。
#      → 见 middleware.ts 的 PUBLIC_PATHS，必须包含 /api/pay/notify。
BEACON_WXPAY_NOTIFY_URL=""

# 微信回调出口 IP 段（若你的防火墙做入站白名单，放行这些）：
#   101.226.103.0/25、140.207.54.0/25、121.51.58.128/25、183.3.234.0/25、
#   58.251.80.0/25、121.51.30.128/25、203.205.219.128/25
#   广州腾讯云：81.71.199.64、81.71.198.25、81.71.199.59
# ⚠️ IP 白名单只是纵深防御，**不能替代验签** —— 源 IP 可伪造，签名不可。

# ── 备份相关 ────────────────────────────────────────────────────
# scripts/backup.sh 现在对**外部连接串**跑 pg_dump：需要 DATABASE_URL（或 BEACON_BACKUP_DATABASE_URL）
# 以及 BEACON_BACKUP_* 变量，均由 cron 环境提供、不从本文件读；本机要装 postgresql-client（pg_dump/pg_restore）。
# 整库灾备优先用火山平台的 PITR/快照，本脚本是异地逻辑导出兜底。见 docs/生产化部署.md「备份与恢复」。

# ── 14. 本轮新增（发票客服 / 站点 URL / 退款）────────────────────
# 【可选】发票/退款走人工客服（不自建开票系统）。billing 页「开具发票」卡与退款转人工分支展示这两个联系方式。
# ⚠️ 不配则卡片显示占位符「（待配置客服微信号/邮箱）」——上线前务必填真实渠道，否则给用户假联系方式。
BEACON_CS_WECHAT=""
BEACON_CS_EMAIL=""

# 【可选】站点根 URL，用于 robots.txt / sitemap.xml 的绝对地址。不配默认 https://your-domain.example.com。
BEACON_SITE_URL=""

# 【可选 · 退款】微信退款结果回调地址。配了则发起退款时把它传给微信、退款结果异步回调兑现；
# 不配则退款靠「发起时的即时状态 + 查单兜底」兑现（内部退款场景够用）。约束同支付 notify_url：
# https 开头、不带 query、外网可达。固定填：https://<域名>/api/pay/refund-notify
BEACON_WXPAY_REFUND_NOTIFY_URL=""

# 【可选 · 退款】内部受控退款接口 /api/internal/pay/refund 的鉴权 token。
# ⚠️ 退款 v1 **默认关闭**：不配此变量则该接口一律 503（退款通道不存在）。
# 配了才启用，且调用需请求头 x-beacon-admin-token 精确匹配。用足够长随机串：openssl rand -hex 32
# 该接口在 middleware 白名单里（ops 用 curl 调，无登录 cookie）—— token 是唯一闸门，只在受信网络使用。
# 退款为 v1：仅全额退款、仅对「其上无后续购买」的订单自助放行，其余转人工（微信商户平台手动退+改库）。
BEACON_ADMIN_TOKEN=""

# ── 微信扫码登录（可选；不填 = 登录页无微信入口，手机号验证码照常可用）──
# 微信开放平台 → 网站应用（需企业资质 + 300元/年认证）
# BEACON_WECHAT_APPID=""
# BEACON_WECHAT_SECRET=""

# ── 出海代理（国内服务器接 YouTube/Google 必需，否则 GFW 挡死）──────
# BEACON_HTTP_PROXY=""
# BEACON_YOUTUBE_REGION="US"

# ── 热点聚类相似度阈值（不填用代码内默认，一般不用动）──────────────
# BEACON_CLUSTER_SIM=""

# ── 15. 邮件通道：已整体下线（2026-07-30），本节保留只为说明「不用配」──────────
# 产品决定不铺邮件通道：套餐/试用到期提醒改由三条腿承担——
#   ① 站内通知（通知中心小铃铛，plan_expiry_notice 任务写入）
#   ② 顶部横幅（components/ExpiryBanner.tsx，每次开页现算，不依赖任务跑没跑过）
#   ③ 机器人推送（飞书/钉钉/企微群，用户在「设置 → 机器人集成」自行配置）
# 发票沟通仍用 BEACON_CS_WECHAT / BEACON_CS_EMAIL 这两个**静态联系方式**（不发信，只展示）。

# ── 15.1 运维告警出口 ─────────────────────────────────────────────────────────
# 默认**复用你在「设置 → 机器人集成」里已经配好的机器人**，不需要另外建 webhook：
#   · 全库只有一个启用中的机器人集成 → 自动用它
#   · 有多个 → 必须用 BEACON_OPS_WORKSPACE_ID 指名道姓（发错群没有撤回键，代码不猜）
#   · 一个都没配 → 不推送（这是产品口径，不是故障）
# 推什么：生产 log.error（同指纹 10 分钟一条、每小时封顶 12 条）+ 备份/恢复演练失败。
BEACON_OPS_WORKSPACE_ID=""

# 【可选】只有在「不想用站内机器人、要单独一个群」时才填。填了就优先走它。
# ⚠️ scripts/cron-backup.sh 是 bash，读不到库里的机器人配置——
#    想让**备份失败**也有告警，就得填这一条（应用内的错误告警不受影响）。
BEACON_OPS_WEBHOOK=""

# ── 15.2 备份异地副本（S3 兼容对象存储：腾讯云 COS / 阿里云 OSS / MinIO）────────
# 不配 = 备份只在这台机器的本地磁盘上，机器没了备份跟着没。四项填齐才启用。
# ⚠️ 桶必须私有（内容等价于生产库），且 BEACON_MASTER_KEY 要**另外异地保管**，
#    否则还原出来的 BYOK 密文全是废数据。上传失败会让备份任务整体失败并告警（有意为之）。
BEACON_BACKUP_S3_BUCKET=""      # 桶名，可带前缀：my-bucket/beacon
BEACON_BACKUP_S3_ENDPOINT=""    # 如 https://cos.ap-guangzhou.myqcloud.com
BEACON_BACKUP_S3_KEY=""
BEACON_BACKUP_S3_SECRET=""
BEACON_BACKUP_S3_REGION=""      # 可选，默认 auto
