# 烽火台 · 私有化部署环境（复制为 .env.private 后填写）
#
# 与 SaaS 的 .env.production 相比，少了整整三类东西：
#   支付（BEACON_WXPAY_*）、短信（BEACON_VOLC_SMS_*）、平台 AI 渠道（BEACON_DEFAULT_LLM_*）。
# 它们在 private 形态下**一律不生效**（lib/edition.ts 的能力矩阵），配了也白配 ——
# preflight 还会因为「企业版不该有支付凭证」直接报 FAIL，提醒你是不是抄错了文件。

# ── 形态（不要改）────────────────────────────────────────────────
BEACON_EDITION=private
NODE_ENV=production

# ── 站点 ────────────────────────────────────────────────────────
# 必须是客户实际访问的地址。它同时决定登录 cookie 带不带 Secure（lib/auth-constants.ts）：
# https 才带；写错成 http 而实际走 https，用户会「登进去又被弹回登录页」且没有任何报错。
BEACON_SITE_URL=https://beacon.你的域名.com

# 反代层数。私有化版编排里 proxy 是唯一入口 → 填 1。
# 填 0 会让全站 IP 限流退化成一个桶（约 30 请求瘫痪全站登录）。
BEACON_TRUSTED_PROXY_HOPS=1

# ── 数据库（compose 内的 db 服务）──────────────────────────────
POSTGRES_USER=beacon
POSTGRES_PASSWORD=换成强密码
POSTGRES_DB=beacon
DATABASE_URL="postgresql://beacon:换成强密码@db:5432/beacon?schema=beacon"

# ── Redis（compose 内）─────────────────────────────────────────
REDIS_PASSWORD=换成强密码
BEACON_QUEUE=bullmq

# ── 主密钥 ──────────────────────────────────────────────────────
# 生成：openssl rand -hex 32
# ⚠️ 库里所有加密字段（模型 Key、机器人密钥）都用它。换掉 = 那些字段全部变乱码。
BEACON_MASTER_KEY=

# ── 装机口令 ────────────────────────────────────────────────────
# 生成：openssl rand -hex 16
# 第一次打开站点时用它完成 /setup 装机（建管理员 / 填模型 Key / 配企业应用）。
# 不配的话装机向导会拒绝执行 —— 那等于谁先打开谁就是管理员。
BEACON_SETUP_TOKEN=

# ── 可选 ────────────────────────────────────────────────────────
# 客户有合规出海出口时再填（私有化版不含 xray）
# BEACON_HTTP_PROXY=
# BEACON_SENTRY_DSN=
